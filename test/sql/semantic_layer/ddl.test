# name: test/sql/semantic_layer/ddl.test
# description: CREATE / DROP SEMANTIC VIEW lifecycle
# group: [semantic_layer]

require semantic_layer

statement ok
CREATE TABLE orders (id INTEGER, customer_id INTEGER, amount DECIMAL(10, 2), order_date DATE);

statement ok
CREATE TABLE customers (id INTEGER, name VARCHAR, metrics VARCHAR);

query I
CREATE SEMANTIC VIEW sales
  TABLES (
    o AS orders PRIMARY KEY (id) WITH SYNONYMS ('sales orders') COMMENT = 'All orders',
    c AS customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    orders_to_customers AS o (customer_id) REFERENCES c
  )
  FACTS (
    o.amount_x2 AS amount * 2
  )
  DIMENSIONS (
    o.order_date AS order_date COMMENT = 'Date of the order',
    c.customer_name AS c.name,
    c.metrics AS metrics
  )
  METRICS (
    o.revenue AS SUM(o.amount),
    o.order_count AS COUNT(*),
    avg_order AS o.revenue / o.order_count
  )
  COMMENT = 'Sales semantic view';
----
Semantic view SALES successfully created.

query IIII
SELECT name, database_name, schema_name, comment FROM (SHOW SEMANTIC VIEWS);
----
sales	memory	main	Sales semantic view

# names are case-insensitive
statement error
CREATE SEMANTIC VIEW SALES TABLES (o AS orders PRIMARY KEY (id)) METRICS (o.n AS COUNT(*));
----
Semantic view with name "SALES" already exists

query I
CREATE SEMANTIC VIEW IF NOT EXISTS sales TABLES (o AS orders PRIMARY KEY (id)) METRICS (o.n AS COUNT(*));
----
SALES already exists, statement succeeded.

# IF NOT EXISTS did not replace the definition
query I
SELECT comment FROM (SHOW SEMANTIC VIEWS);
----
Sales semantic view

query I
CREATE OR REPLACE SEMANTIC VIEW sales TABLES (o AS orders PRIMARY KEY (id)) METRICS (o.n AS COUNT(*)) COMMENT = 'v2';
----
Semantic view SALES successfully created.

query I
SELECT comment FROM (SHOW SEMANTIC VIEWS);
----
v2

statement ok
CREATE OR ALTER SEMANTIC VIEW sales TABLES (o AS orders PRIMARY KEY (id)) METRICS (o.n AS COUNT(*)) COMMENT = 'v3';

query I
SELECT comment FROM (SHOW SEMANTIC VIEWS);
----
v3

# schema-qualified names
statement ok
CREATE SCHEMA analytics;

statement ok
CREATE SEMANTIC VIEW analytics.sales TABLES (o AS main.orders PRIMARY KEY (id)) METRICS (o.n AS COUNT(*));

query II
SELECT schema_name, name FROM (SHOW SEMANTIC VIEWS) ORDER BY ALL;
----
analytics	sales
main	sales

query II
SELECT schema_name, name FROM (SHOW SEMANTIC VIEWS IN SCHEMA analytics);
----
analytics	sales

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS LIKE 'sal%');
----
2

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS LIKE 'nope%');
----
0

query I
DROP SEMANTIC VIEW analytics.sales;
----
SALES successfully dropped.

statement error
DROP SEMANTIC VIEW analytics.sales;
----
Semantic view with name "sales" does not exist

query I
DROP SEMANTIC VIEW IF EXISTS analytics.sales;
----
Drop statement executed successfully (SALES already dropped).

statement ok
DROP SEMANTIC VIEW Sales;

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS);
----
0

# definitions with quoted / mixed-case identifiers
statement ok
CREATE TABLE "Order Lines" ("Line Id" INTEGER, "Amount" DOUBLE);

statement ok
CREATE SEMANTIC VIEW "Mixed Case" TABLES ("Lines" AS "Order Lines" PRIMARY KEY ("Line Id")) DIMENSIONS ("Lines"."Line Id" AS "Line Id") METRICS ("Lines"."Total Amount" AS SUM("Amount"));

query I
SELECT name FROM (SHOW SEMANTIC VIEWS);
----
Mixed Case

# EXPLAIN does not create the view
statement ok
EXPLAIN CREATE SEMANTIC VIEW not_created TABLES (o AS orders PRIMARY KEY (id)) METRICS (o.n AS COUNT(*));

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS) WHERE name = 'not_created';
----
0

# a logical table can be a query
statement ok
CREATE SEMANTIC VIEW big_orders TABLES (b AS (SELECT * FROM orders WHERE amount > 100) PRIMARY KEY (id)) METRICS (b.n AS COUNT(*));

query I
SELECT name FROM (SHOW SEMANTIC VIEWS) WHERE name = 'big_orders';
----
big_orders

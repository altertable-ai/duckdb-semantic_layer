# name: test/sql/semantic_layer/materializations_dependencies.test
# description: cache dependencies follow expanded facts, dimensions and subqueries
# group: [semantic_layer]

require semantic_layer

require parquet

require ducklake

load __TEST_DIR__/materializations_dependencies.db

statement ok
ATTACH 'ducklake:__TEST_DIR__/dependencies.ducklake' AS lake (DATA_PATH '__TEST_DIR__/dependencies_data');
CREATE TABLE lake.sales (id INTEGER, rate_id INTEGER, amount INTEGER);
INSERT INTO lake.sales VALUES (1, 1, 10);
CREATE TABLE lake.rates (id INTEGER, rate INTEGER);
INSERT INTO lake.rates VALUES (1, 2);

statement ok
CREATE SEMANTIC VIEW converted
  TABLES (s AS lake.sales PRIMARY KEY (id), r AS lake.rates PRIMARY KEY (id))
  RELATIONSHIPS (s (rate_id) REFERENCES r)
  FACTS (s.converted AS amount * r.rate)
  DIMENSIONS (s.bucket AS r.rate)
  METRICS (s.total AS SUM(s.converted));
ALTER SEMANTIC VIEW converted ADD MATERIALIZATION totals AS METRICS s.total;
ALTER SEMANTIC VIEW converted ADD MATERIALIZATION buckets AS DIMENSIONS s.bucket METRICS s.total;

statement ok
UPDATE lake.rates SET rate = 3;

query I
SELECT count(*) FROM (SHOW SEMANTIC MATERIALIZATIONS IN converted) WHERE usable;
----
0

query I
SELECT * FROM SEMANTIC_VIEW(converted METRICS s.total);
----
30

statement ok
ALTER SEMANTIC VIEW converted REFRESH MATERIALIZATION totals INCREMENTAL;
ALTER SEMANTIC VIEW converted REFRESH MATERIALIZATION buckets AUTO;

query I
SELECT * FROM SEMANTIC_VIEW(converted METRICS s.total);
----
30

query II
SELECT * FROM SEMANTIC_VIEW(converted DIMENSIONS s.bucket METRICS s.total);
----
3	30

statement ok
CREATE TABLE rates (rate INTEGER);
INSERT INTO rates VALUES (2);
CREATE SEMANTIC VIEW indirect
  TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(amount * (SELECT rate FROM rates)));
ALTER SEMANTIC VIEW indirect ADD MATERIALIZATION totals AS METRICS s.total;

query II
SELECT incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN indirect);
----
false	false

statement ok
UPDATE rates SET rate = 4;
ALTER SEMANTIC VIEW indirect REFRESH MATERIALIZATION totals;

query I
SELECT * FROM SEMANTIC_VIEW(indirect METRICS s.total);
----
40

# Binding expands macros after semantic expression compilation.
statement ok
CREATE MACRO converted_amount(x) AS x * (SELECT rate FROM rates);
CREATE SEMANTIC VIEW macro_indirect
  TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(converted_amount(amount)));
ALTER SEMANTIC VIEW macro_indirect ADD MATERIALIZATION totals AS METRICS s.total;

query II
SELECT incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN macro_indirect);
----
false	false

statement ok
UPDATE rates SET rate = 5;

query I
SELECT * FROM SEMANTIC_VIEW(macro_indirect METRICS s.total);
----
50

# Old metadata can contain tracked watermarks for incomplete dependencies.
statement ok
UPDATE __semantic_materializations.__sv_materializations
  SET watermark_catalogs = ['lake'], watermark_snapshots = [(SELECT id FROM ducklake_current_snapshot('lake'))]
  WHERE view_name = 'indirect';

restart

statement ok
ATTACH 'ducklake:__TEST_DIR__/dependencies.ducklake' AS lake (DATA_PATH '__TEST_DIR__/dependencies_data');
CREATE OR REPLACE SEMANTIC VIEW indirect
  TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(amount * (SELECT rate FROM rates)));

query II
SELECT incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN indirect);
----
false	false

statement ok
ALTER SEMANTIC VIEW indirect REFRESH MATERIALIZATION totals;

query I
SELECT * FROM SEMANTIC_VIEW(indirect METRICS s.total);
----
50

# Missing persisted tables are rebuilt after reattachment, rather than adopting a live state.
statement ok
CREATE SEMANTIC VIEW missing_view TABLES (s AS lake.sales PRIMARY KEY (id)) METRICS (s.total AS SUM(amount));
ALTER SEMANTIC VIEW missing_view ADD MATERIALIZATION m AS METRICS s.total;
UPDATE __semantic_materializations.__sv_materializations SET tables = ['missing_block'] WHERE view_name = 'missing_view';

restart

statement ok
ATTACH 'ducklake:__TEST_DIR__/dependencies.ducklake' AS lake (DATA_PATH '__TEST_DIR__/dependencies_data');
CREATE OR REPLACE SEMANTIC VIEW missing_view TABLES (s AS lake.sales PRIMARY KEY (id)) METRICS (s.total AS SUM(amount));

query I
ALTER SEMANTIC VIEW missing_view REFRESH MATERIALIZATION m;
----
Materialization m refreshed (FULL: its table missing_block is missing).

# Pure macros can change cached values without changing a tracked table.
statement ok
CREATE MACRO scale_amount(x) AS x * 2;
CREATE SEMANTIC VIEW macro_scaled TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(scale_amount(amount)));
ALTER SEMANTIC VIEW macro_scaled ADD MATERIALIZATION totals AS METRICS s.total;
CREATE OR REPLACE MACRO scale_amount(x) AS x * 3;
CREATE OR REPLACE SEMANTIC VIEW macro_scaled TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(scale_amount(amount)));

query II
SELECT incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN macro_scaled);
----
false	false

query I
SELECT * FROM SEMANTIC_VIEW(macro_scaled METRICS s.total);
----
30

# A macro may discard an expected child scan and introduce another scan of the same table.
statement ok
CREATE TABLE lake.customers (id INTEGER);
INSERT INTO lake.customers VALUES (1), (2);
CREATE TABLE lake.orders (id INTEGER, customer_id INTEGER, amount INTEGER);
INSERT INTO lake.orders VALUES (1, 1, 10);
CREATE MACRO global_total(x) AS (SELECT SUM(amount) FROM lake.orders);
CREATE SEMANTIC VIEW macro_replaced_scan
  TABLES (c AS lake.customers PRIMARY KEY (id), o AS lake.orders PRIMARY KEY (id))
  RELATIONSHIPS (o (customer_id) REFERENCES c)
  FACTS (c.order_total AS SUM(o.amount))
  METRICS (c.total AS SUM(global_total(c.order_total)));
ALTER SEMANTIC VIEW macro_replaced_scan ADD MATERIALIZATION totals AS METRICS c.total;
UPDATE lake.orders SET amount = 20;

query II
SELECT incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN macro_replaced_scan);
----
false	false

statement error
ALTER SEMANTIC VIEW macro_replaced_scan REFRESH MATERIALIZATION totals INCREMENTAL;
----
replaceable SQL macro

statement ok
ALTER SEMANTIC VIEW macro_replaced_scan REFRESH MATERIALIZATION totals AUTO;

query I
SELECT * FROM SEMANTIC_VIEW(macro_replaced_scan METRICS c.total);
----
40

statement ok
ATTACH ':memory:' AS macros;
CREATE MACRO macros.scale(x) AS x * 2;
CREATE MACRO receiver_scale(x) AS x * 2;
CREATE SEMANTIC VIEW qualified_macro TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(macros.scale(amount)), s.receiver AS SUM(amount.receiver_scale()));
ALTER SEMANTIC VIEW qualified_macro ADD MATERIALIZATION totals AS METRICS s.total, s.receiver;
CREATE OR REPLACE MACRO macros.scale(x) AS x * 3;
CREATE OR REPLACE MACRO receiver_scale(x) AS x * 4;
CREATE OR REPLACE SEMANTIC VIEW qualified_macro TABLES (s AS lake.sales PRIMARY KEY (id))
  METRICS (s.total AS SUM(macros.scale(amount)), s.receiver AS SUM(amount.receiver_scale()));

query II
SELECT incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN qualified_macro);
----
false	false

query II
SELECT * FROM SEMANTIC_VIEW(qualified_macro METRICS s.total, s.receiver);
----
30	40

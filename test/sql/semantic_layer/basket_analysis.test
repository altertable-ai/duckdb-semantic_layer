# name: test/sql/semantic_layer/basket_analysis.test
# description: manufacturer-pair lift preserves order grain when composing semantic results
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE orders (o_orderkey INTEGER, o_orderdate DATE);
INSERT INTO orders VALUES
  (1, '1997-01-01'), (2, '1997-06-01'), (3, '1997-12-31'),
  (4, '1997-06-01'), (5, '1997-06-01'), (6, '1996-12-31'), (7, '1998-01-01');
CREATE TABLE part (p_partkey INTEGER, p_mfgr VARCHAR);
INSERT INTO part VALUES (1, 'A'), (2, 'A'), (3, 'B'), (4, 'C');
CREATE TABLE lineitem (l_orderkey INTEGER, l_linenumber INTEGER, l_partkey INTEGER);
INSERT INTO lineitem VALUES
  (1, 1, 1), (1, 2, 2), (2, 1, 3), (3, 1, 1), (3, 2, 2), (3, 3, 3),
  (5, 1, 4), (6, 1, 1), (6, 2, 4), (7, 1, 3), (7, 2, 4);

statement ok
CREATE SEMANTIC VIEW baskets
  TABLES (
    orders AS orders PRIMARY KEY (o_orderkey),
    lineitem AS lineitem PRIMARY KEY (l_orderkey, l_linenumber),
    part AS part PRIMARY KEY (p_partkey)
  )
  RELATIONSHIPS (
    line_order AS lineitem (l_orderkey) REFERENCES orders,
    line_part AS lineitem (l_partkey) REFERENCES part
  )
  DIMENSIONS (
    orders.order_key AS o_orderkey,
    orders.order_date AS o_orderdate,
    part.manufacturer AS p_mfgr
  )
  METRICS (orders.order_count AS COUNT(*), lineitem.line_count AS COUNT(*));

# A and B each appear in two orders, together in one. All five 1997 orders count,
# including order 4 without lines. C has no pair; orders outside 1997 add none.
query TTIR
WITH memberships AS (
  SELECT orders.order_key AS order_key, part.manufacturer AS manufacturer
  FROM baskets
  WHERE orders.order_date >= DATE '1997-01-01' AND orders.order_date < DATE '1998-01-01'
  GROUP BY orders.order_key, part.manufacturer
  HAVING AGG(lineitem.line_count) > 0
), counts AS (
  SELECT manufacturer, COUNT(*) AS orders FROM memberships GROUP BY manufacturer
), pairs AS (
  SELECT a.manufacturer AS manufacturer_a, b.manufacturer AS manufacturer_b, COUNT(*) AS orders_with_both
  FROM memberships a JOIN memberships b ON a.order_key = b.order_key AND a.manufacturer < b.manufacturer
  GROUP BY a.manufacturer, b.manufacturer
), totals AS (
  SELECT AGG(orders.order_count) AS orders FROM baskets
  WHERE orders.order_date >= DATE '1997-01-01' AND orders.order_date < DATE '1998-01-01'
)
SELECT p.manufacturer_a, p.manufacturer_b, p.orders_with_both,
       p.orders_with_both * 1.0 * t.orders / (a.orders * b.orders) AS lift
FROM pairs p
JOIN counts a ON a.manufacturer = p.manufacturer_a
JOIN counts b ON b.manufacturer = p.manufacturer_b
CROSS JOIN totals t;
----
A	B	1	1.25

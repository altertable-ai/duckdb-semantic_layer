# name: test/sql/semantic_layer/time_spine.test
# description: built-in time spine (TIME (<column>) and metric_time): grains, join elimination, offsets, cumulative anchors
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE accounts (account_id INTEGER, country VARCHAR);

statement ok
INSERT INTO accounts VALUES (1, 'FR'), (2, 'US'), (3, 'DE');

statement ok
CREATE TABLE invoices (invoice_id INTEGER, account_id INTEGER, invoiced_at DATE, amount INTEGER);

statement ok
INSERT INTO invoices VALUES
  (1, 1, '2026-01-01', 10), (2, 1, '2026-01-01', 5), (3, 2, '2026-01-03', 7), (4, 1, '2026-02-02', 20),
  (5, 3, NULL, 100), (6, 1, '2025-01-15', 4), (7, 9, '2026-03-01', 1);

statement ok

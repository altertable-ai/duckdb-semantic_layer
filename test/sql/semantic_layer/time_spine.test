# WHERE on the year selects 2026 anchors; their windows still read 2025
query I
SELECT running FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.running WHERE metric_time.year = DATE '2026-01-01')
WHERE day = DATE '2026-01-01';
----
19

query I
WITH facts AS (
  SELECT invoiced_at AS d, amount FROM invoices WHERE invoiced_at IS NOT NULL
), bounds AS (
  SELECT min(d) AS lo, max(d) AS hi FROM facts
), anchors AS (
  SELECT unnest(generate_series(lo, hi, INTERVAL 1 DAY))::DATE AS day FROM bounds
), expected AS (
  SELECT a.day, SUM(f.amount) AS running FROM anchors a JOIN facts f ON f.d <= a.day GROUP BY a.day
), actual AS (
  SELECT day, running FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.running)
)
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT SELECT * FROM actual) UNION ALL (SELECT * FROM actual EXCEPT SELECT * FROM expected));
----
0

query II
SELECT day, last_7 FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.last_7)
WHERE day IN (DATE '2026-01-02', DATE '2026-01-03') ORDER BY day;
----
2026-01-02	15
2026-01-03	22

query I
WITH facts AS (
  SELECT invoiced_at AS d, amount FROM invoices WHERE invoiced_at IS NOT NULL
), bounds AS (
  SELECT min(d) AS lo, max(d) AS hi FROM facts
), anchors AS (
  SELECT unnest(generate_series(lo, hi, INTERVAL 1 DAY))::DATE AS day FROM bounds
), expected AS (
  SELECT a.day, SUM(f.amount) AS last_7
  FROM anchors a JOIN facts f ON f.d <= a.day AND f.d > a.day - INTERVAL 7 DAY
  GROUP BY a.day
), actual AS (
  SELECT day, last_7 FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.last_7)
)
SELECT count(*) FROM ((SELECT * FROM expected EXCEPT SELECT * FROM actual) UNION ALL (SELECT * FROM actual EXCEPT SELECT * FROM expected));
----
0

query II
SELECT month, mtd FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.mtd) ORDER BY month;
----
2025-01-01	4
2026-01-01	22
2026-02-01	20
2026-03-01	1

# the spine is not joined, and a cumulative metric scans the fact table once (the dated rows are materialized)
query I
SELECT sql NOT ILIKE '%metric_time%'
  AND (length(sql) - length(replace(sql, 'FROM memory.main.invoices', ''))) / length('FROM memory.main.invoices') = 1
FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.revenue)');
----
true

query I
SELECT sql ILIKE '%AS MATERIALIZED%' AND sql NOT ILIKE '%metric_time%'
  AND (length(sql) - length(replace(sql, 'FROM memory.main.invoices', ''))) / length('FROM memory.main.invoices') = 1
FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.running)');
----
true

query II
SELECT month, running_months
FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.running_months WHERE metric_time.month IS NOT NULL)
ORDER BY month;
----
2025-01-01	4
2026-01-01	26
2026-02-01	46
2026-03-01	47


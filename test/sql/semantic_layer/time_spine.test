2026-02-01	20	NULL
2026-03-01	1	NULL

# a day with no invoices is absent from a plain aggregate and present in the running total (4 + 10 + 5)
query I
SELECT count(*) FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.revenue) WHERE day = DATE '2026-01-02';

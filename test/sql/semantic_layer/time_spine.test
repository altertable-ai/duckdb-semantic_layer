# a range hop in front of the spine reads the matched row's TIME column
statement ok
CREATE TABLE periods (id INTEGER, start_time TIMESTAMP, end_time TIMESTAMP);

statement ok
INSERT INTO periods VALUES
  (1, '2026-01-01 00:00:00', '2026-01-10 00:00:00'),
  (2, '2026-01-10 00:00:00', '2026-02-01 00:00:00');

statement ok
CREATE TABLE hits (id INTEGER, ts TIMESTAMP, n INTEGER);

statement ok
INSERT INTO hits VALUES (1, '2026-01-05 12:00:00', 3), (2, '2026-01-15 12:00:00', 4);

statement ok
CREATE SEMANTIC VIEW ranged
  TABLES (
    periods PRIMARY KEY (id) TIME (start_time)
      CONSTRAINT r DISTINCT RANGE BETWEEN start_time AND end_time EXCLUSIVE,
    hits PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    hits (ts) REFERENCES periods (BETWEEN start_time AND end_time EXCLUSIVE)
  )
  METRICS (hits.n AS SUM(n));

query II
SELECT day, n FROM SEMANTIC_VIEW(ranged DIMENSIONS metric_time.day METRICS hits.n) ORDER BY day;
----
2026-01-01	3
2026-01-10	4


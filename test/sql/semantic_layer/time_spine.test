# two TIME columns: ambiguous until USING picks a relationship into the spine
statement ok
CREATE TABLE side_a (id INTEGER, d DATE, n INTEGER);

statement ok
INSERT INTO side_a VALUES (1, '2026-01-01', 1);

statement ok
CREATE TABLE side_b (id INTEGER, d DATE, n INTEGER);

statement ok
INSERT INTO side_b VALUES (1, '2026-02-01', 2);

statement ok
CREATE TABLE link (id INTEGER, a_id INTEGER, b_id INTEGER, n INTEGER);

statement ok
INSERT INTO link VALUES (1, 1, 1, 5);

statement ok
CREATE SEMANTIC VIEW bridge
  TABLES (
    a AS side_a PRIMARY KEY (id) TIME (d),
    b AS side_b PRIMARY KEY (id) TIME (d),
    link PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    link (a_id) REFERENCES a,
    link (b_id) REFERENCES b
  )
  METRICS (
    link.total AS SUM(n),
    link.via_a USING (a_to_metric_time) AS SUM(n),
    link.via_b USING (b_to_metric_time) AS SUM(n)
  );

statement error
SELECT * FROM SEMANTIC_VIEW(bridge DIMENSIONS metric_time.day METRICS link.total);
----
multiple relationship paths


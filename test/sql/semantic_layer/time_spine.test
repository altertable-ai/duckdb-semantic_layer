statement ok
INSERT INTO lines VALUES (1, 1, 1), (2, 1, 2), (3, 1, 3);

statement ok
CREATE TABLE costs (cost_id INTEGER, incurred_at DATE, cost INTEGER);

statement ok
INSERT INTO costs VALUES (1, '2026-01-01', 3), (2, '2026-02-02', 8);

statement ok
CREATE SEMANTIC VIEW shop
  TABLES (
    account AS accounts PRIMARY KEY (account_id),
    invoices PRIMARY KEY (invoice_id) TIME (invoiced_at),
    lines PRIMARY KEY (line_id),
    costs PRIMARY KEY (cost_id) TIME (incurred_at)
  )
  RELATIONSHIPS (
    invoices (account_id) REFERENCES account,
    lines (invoice_id) REFERENCES invoices
  )
  DIMENSIONS (
    account.country AS country,
    metric_time.weekday AS dayofweek(day),
    invoices.only_time AS metric_time.day
  )
  METRICS (
    invoices.revenue AS SUM(amount),
    invoices.n AS COUNT(*),
    costs.cost AS SUM(cost),
    lines.qty AS SUM(qty),
    invoices.revenue_ly OFFSET (metric_time.day BY INTERVAL 1 YEAR) AS revenue,
    invoices.running CUMULATIVE (metric_time.day) AS SUM(amount),
    invoices.last_7 CUMULATIVE (metric_time.day OVER INTERVAL 7 DAYS) AS SUM(amount),
    invoices.mtd CUMULATIVE (metric_time.day TO MONTH) AS SUM(amount),
    invoices.running_months AS SUM(revenue) OVER (ORDER BY metric_time.month)
  );

# every grain, including the NULL date as its own group, matches date_trunc of the fact column
query I
WITH facts AS (
  SELECT invoiced_at AS d, amount FROM invoices
), grains AS (
  SELECT 'day' AS grain, d AS g, SUM(amount) AS revenue FROM facts GROUP BY d
  UNION ALL
  SELECT 'week', date_trunc('week', d)::DATE, SUM(amount) FROM facts GROUP BY 2
  UNION ALL
  SELECT 'month', date_trunc('month', d)::DATE, SUM(amount) FROM facts GROUP BY 2
  UNION ALL
  SELECT 'quarter', date_trunc('quarter', d)::DATE, SUM(amount) FROM facts GROUP BY 2
  UNION ALL
  SELECT 'year', date_trunc('year', d)::DATE, SUM(amount) FROM facts GROUP BY 2
), actual AS (
  SELECT 'day' AS grain, day AS g, revenue FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day METRICS invoices.revenue)
  UNION ALL
  SELECT 'week', week, revenue FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.week METRICS invoices.revenue)
  UNION ALL
  SELECT 'month', month, revenue FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.revenue)
  UNION ALL
  SELECT 'quarter', quarter, revenue FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.quarter METRICS invoices.revenue)
  UNION ALL
  SELECT 'year', year, revenue FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.year METRICS invoices.revenue)
)
SELECT count(*) FROM ((SELECT * FROM grains EXCEPT SELECT * FROM actual) UNION ALL (SELECT * FROM actual EXCEPT SELECT * FROM grains));
----
0

# WHERE on a grain keeps that period, and drops the NULL date
query II
SELECT month, revenue
FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.revenue WHERE metric_time.year = DATE '2026-01-01')
ORDER BY month;
----
2026-01-01	22
2026-02-01	20
2026-03-01	1

# two facts merge on metric_time.month; a missing side is NULL, and the NULL invoice date is its own group
query III
SELECT month, revenue, cost
FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.revenue, costs.cost)
ORDER BY month NULLS LAST;
----
2025-01-01	4	NULL
2026-01-01	22	3
2026-02-01	20	8
2026-03-01	1	NULL
NULL	100	NULL

# the account join does not multiply revenue, and an invoice with no account is a NULL country
query II
SELECT country, revenue FROM SEMANTIC_VIEW(shop DIMENSIONS account.country METRICS invoices.revenue) ORDER BY country NULLS LAST;
----
DE	100
FR	39
US	7
NULL	1

# lines inherit the invoice time, and joining them does not multiply revenue (invoice 1 has three lines)
query III
SELECT month, revenue, qty
FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.revenue, lines.qty)
WHERE month = DATE '2026-01-01';
----
2026-01-01	22	6

query II
SELECT month, AGG(revenue) FROM shop GROUP BY month HAVING month = DATE '2026-01-01';
----
2026-01-01	22

# 2026-01-01 is a Thursday (DuckDB dayofweek: Sunday = 0)
query I
SELECT weekday FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.day, metric_time.weekday METRICS invoices.revenue) WHERE day = DATE '2026-01-01';
----
4

# OFFSET moves the grain with the day
query III
SELECT month, revenue, revenue_ly
FROM SEMANTIC_VIEW(shop DIMENSIONS metric_time.month METRICS invoices.revenue, invoices.revenue_ly WHERE metric_time.year = DATE '2026-01-01')
ORDER BY month;

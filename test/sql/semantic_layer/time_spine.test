  TABLES (
    trials AS (SELECT event_id, occurred_at FROM (VALUES (1, DATE '2026-04-01'), (2, DATE '2026-04-02')) t(event_id, occurred_at))
      PRIMARY KEY (event_id) TIME (occurred_at)
  )
  METRICS (trials.n AS COUNT(*));


# TIMESTAMP time column, role-playing date, and a child that follows TIME unless USING says otherwise
statement ok
CREATE TABLE shipments (shipment_id INTEGER, ordered_at TIMESTAMP, shipped_at TIMESTAMP, booked INTEGER);

statement ok
INSERT INTO shipments VALUES (1, '2026-01-01 15:00:00', '2026-01-03 10:00:00', 10);

statement ok
CREATE TABLE details (detail_id INTEGER, shipment_id INTEGER, fees INTEGER);

statement ok
INSERT INTO details VALUES (1, 1, 2);

statement ok
CREATE SEMANTIC VIEW logistics
  TABLES (
    shipments PRIMARY KEY (shipment_id) TIME (ordered_at),
    details PRIMARY KEY (detail_id)
  )
  RELATIONSHIPS (
    details (shipment_id) REFERENCES shipments,
    shipped AS shipments (shipped_at) REFERENCES metric_time
  )
  METRICS (
    shipments.booked_amount AS SUM(booked),
    shipments.shipped_amount USING (shipped) AS SUM(booked),
    details.fee_total AS SUM(fees),
    details.fees_shipped USING (shipped) AS SUM(fees)
  );


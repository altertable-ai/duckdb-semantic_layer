# name: test/sql/semantic_layer/query_metric_filters.test
# description: query-time metric filters: AGG(<metric>) FILTER (WHERE <condition>) in SEMANTIC_VIEW(...) METRICS
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE accounts (account_id INTEGER, segment VARCHAR, country VARCHAR);

statement ok
INSERT INTO accounts VALUES (1, 'enterprise', 'FR'), (2, 'startup', 'US'), (3, 'enterprise', 'DE'), (4, 'startup', 'FR');

statement ok
CREATE TABLE invoices (invoice_id INTEGER, account_id INTEGER, invoiced_at DATE, amount INTEGER);

statement ok
INSERT INTO invoices VALUES
  (1, 1, '2025-09-03', 800), (2, 2, '2025-09-10', 400), (3, 3, '2025-10-20', 600), (4, 4, '2025-12-31', 300),
  (5, 1, '2026-09-01', 1000), (6, 2, '2026-09-15', 500), (7, 1, '2026-09-15', 1200), (8, 3, '2026-10-10', 900),
  (9, 4, '2026-02-28', 250);

statement ok
CREATE TABLE costs (cost_id INTEGER, account_id INTEGER, incurred_at DATE, cost INTEGER);

statement ok
INSERT INTO costs VALUES (1, 1, '2025-09-03', 160), (2, 2, '2025-09-10', 90), (3, 3, '2025-10-20', 170),
  (4, 1, '2026-09-01', 250), (5, 2, '2026-09-15', 80), (6, 3, '2026-10-10', 180);

statement ok
CREATE TABLE balances (account_id INTEGER, as_of DATE, balance INTEGER);

statement ok
INSERT INTO balances VALUES
  (1, '2025-06-30', 1000), (2, '2025-06-30', 500), (3, '2025-12-31', 700), (4, '2025-12-31', 50),
  (1, '2026-06-30', 1200), (2, '2026-06-30', 450), (3, '2026-12-31', 800);

statement ok
CREATE SEMANTIC VIEW ledger
  TABLES (
    account AS accounts PRIMARY KEY (account_id),
    invoices PRIMARY KEY (invoice_id) TIME (invoiced_at),
    costs PRIMARY KEY (cost_id) TIME (incurred_at),
    balances PRIMARY KEY (account_id, as_of)
  )
  RELATIONSHIPS (
    invoices (account_id) REFERENCES account,
    costs (account_id) REFERENCES account,
    balances (account_id) REFERENCES account
  )
  DIMENSIONS (
    account.segment AS segment,
    account.country AS country,
    balances.as_of_day AS as_of,
    balances.as_of_year AS year(as_of)
  )
  METRICS (
    invoices.revenue AS SUM(amount),
    invoices.enterprise_revenue FILTER (WHERE account.segment = 'enterprise') AS SUM(amount),
    costs.cost AS SUM(cost),
    margin AS (invoices.revenue - costs.cost) / invoices.revenue,
    enterprise_margin FILTER (WHERE account.segment = 'enterprise') AS margin,
    fr_enterprise_margin FILTER (WHERE account.country = 'FR') AS enterprise_margin,
    enterprise_margin_ly OFFSET (metric_time.day BY INTERVAL 1 YEAR) AS enterprise_margin,
    balances.balance NON ADDITIVE BY (balances.as_of_day) AS SUM(balance),
    balances.enterprise_balance FILTER (WHERE account.segment = 'enterprise') AS balance
  );

#===--------------------------------------------------------------------===#
# AGG(<metric>) FILTER (WHERE <condition>) is the metric defined with FILTER (WHERE <condition>)
#===--------------------------------------------------------------------===#

# a derived metric: the condition filters every aggregate it is computed from
foreach dimension metric_time.month account.country

query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension}
       METRICS AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS enterprise_margin)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension} METRICS enterprise_margin))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension} METRICS enterprise_margin)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension}
       METRICS AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS enterprise_margin))
  )) = 0
   AND (SELECT count(enterprise_margin) FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension}
       METRICS AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS enterprise_margin)) > 0;
----
true

endloop

query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.country
  METRICS margin, AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS enterprise_margin)
ORDER BY country;
----
DE	0.7666666666666667	0.7666666666666667
FR	0.8845070422535212	0.8633333333333333
US	0.8111111111111111	NULL

# a table metric
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS enterprise_revenue)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS enterprise_revenue))
  )) = 0
   AND (SELECT count(enterprise_revenue) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS enterprise_revenue)) > 0;
----
true

# ... and compiles to the same SQL
query I
SELECT (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS AGG(revenue) FILTER (WHERE account.segment = ''enterprise'') AS enterprise_revenue)'))
     = (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS enterprise_revenue)'));
----
true

# a semi-additive metric: the condition filters the rows before the last snapshot is picked
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
       METRICS AGG(balance) FILTER (WHERE account.segment = 'enterprise') AS enterprise_balance)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year METRICS enterprise_balance))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year METRICS enterprise_balance)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
       METRICS AGG(balance) FILTER (WHERE account.segment = 'enterprise') AS enterprise_balance))
  )) = 0
   AND (SELECT count(enterprise_balance) FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
       METRICS AGG(balance) FILTER (WHERE account.segment = 'enterprise') AS enterprise_balance)) > 0;
----
true

# the last snapshot among the enterprise rows (2025-12-31: 700), not the enterprise rows of the last snapshot
query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
  METRICS balance, AGG(balance) FILTER (WHERE account.segment = 'enterprise') AS enterprise_balance)
ORDER BY as_of_year;
----
2025	750	700
2026	800	800

# a filtered metric filtered again: both conditions apply (AND)
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS AGG(enterprise_margin) FILTER (WHERE account.country = 'FR') AS m)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS fr_enterprise_margin AS m))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS fr_enterprise_margin AS m)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS AGG(enterprise_margin) FILTER (WHERE account.country = 'FR') AS m))
  )) = 0
   AND (SELECT count(m) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS AGG(enterprise_margin) FILTER (WHERE account.country = 'FR') AS m)) > 0;
----
true

query I
SELECT (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS AGG(enterprise_margin) FILTER (WHERE account.country = ''FR'') AS fr_enterprise_margin)'))
     = (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS fr_enterprise_margin)'));
----
true

# AGG(<metric>) without FILTER is the metric
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(margin) AS margin)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS margin))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS margin)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(margin) AS margin))
  )) = 0
   AND (SELECT count(margin) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(margin) AS margin)) > 0;
----
true

query I
SELECT (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS AGG(margin) AS margin)'))
     = (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS margin)'));
----
true

# ... also inside an expression and a window function
query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.segment
  METRICS AGG(revenue) * 2 AS double_revenue,
          AGG(revenue) FILTER (WHERE account.country = 'FR') / SUM(AGG(revenue)) OVER () AS fr_share)
ORDER BY segment;
----
enterprise	9000	0.5042016806722689
startup	2900	0.09243697478991597

# composes with time_shift(): the condition reads the stored rows, the shift moves the dimensions
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(AGG(margin) FILTER (WHERE account.segment = 'enterprise'), INTERVAL 1 YEAR) AS m)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_margin_ly AS m))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_margin_ly AS m)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(AGG(margin) FILTER (WHERE account.segment = 'enterprise'), INTERVAL 1 YEAR) AS m))
  )) = 0
   AND (SELECT count(m) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(AGG(margin) FILTER (WHERE account.segment = 'enterprise'), INTERVAL 1 YEAR) AS m)) > 0;
----
true

# ... and with cumulative()
query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.year
  METRICS cumulative(AGG(revenue) FILTER (WHERE account.segment = 'enterprise')) AS running,
          enterprise_revenue)
ORDER BY year;
----
2025-01-01	1400	1400
2026-01-01	4500	3100

# a filter on a dimension the query groups by: the other groups are 0 / NULL, not removed
query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.segment
  METRICS revenue, AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS enterprise_revenue)
ORDER BY segment;
----
enterprise	4500	4500
startup	1450	NULL

# different conditions give different columns; equal conditions share one aggregate
query IIIII
SELECT segment, fr, us, fr = fr_again, fr = fr_twice FROM SEMANTIC_VIEW(ledger DIMENSIONS account.segment
  METRICS AGG(revenue) FILTER (WHERE account.country = 'FR') AS fr,
          AGG(revenue) FILTER (WHERE account.country = 'US') AS us,
          AGG(revenue) FILTER (WHERE account.country = 'FR') AS fr_again,
          AGG(revenue) FILTER (WHERE account.country = 'FR') + 0 AS fr_twice)
ORDER BY segment;
----
enterprise	3000	NULL	true	true
startup	550	900	true	true

# a semi-additive metric filters the rows of its aggregation: equal conditions (also equal to a metric's FILTER) read
# the same rows, different ones need one aggregation each
query III
SELECT contains((SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
          METRICS AGG(balance) FILTER (WHERE account.country = ''FR'') AS a,
                  AGG(balance) FILTER (WHERE account.country = ''FR'') AS b)')), 'UNION ALL'),
       contains((SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
          METRICS AGG(balance) FILTER (WHERE account.segment = ''enterprise'') AS a, enterprise_balance AS b)')),
          'UNION ALL'),
       contains((SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
          METRICS AGG(balance) FILTER (WHERE account.country = ''FR'') AS a,
                  AGG(balance) FILTER (WHERE account.country = ''DE'') AS b)')), 'UNION ALL');
----
false	false	true

query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS balances.as_of_year
  METRICS AGG(balance) FILTER (WHERE account.country = 'FR') AS fr,
          AGG(balance) FILTER (WHERE account.country = 'FR') AS fr_again)
ORDER BY as_of_year;
----
2025	50	50
2026	1200	1200

query IIII
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.segment
  METRICS AGG(margin) FILTER (WHERE account.country = 'FR') AS fr,
          AGG(margin) FILTER (WHERE account.country = 'DE') AS de,
          AGG(margin) FILTER (WHERE account.country = 'FR') AS fr_again)
ORDER BY segment;
----
enterprise	0.8633333333333333	0.7666666666666667	0.8633333333333333
startup	NULL	NULL	NULL

#===--------------------------------------------------------------------===#
# By name: AGG(<metric>) FILTER (WHERE <condition>) is the same metric item
#===--------------------------------------------------------------------===#

foreach dimension segment account.country metric_time.month

query I
SELECT (SELECT count(*) FROM (
    (SELECT {dimension}, AGG(margin) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY {dimension}
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension}
       METRICS AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS enterprise_margin))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS {dimension}
       METRICS AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS enterprise_margin)
     EXCEPT ALL
     SELECT {dimension}, AGG(margin) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY {dimension})
  )) = 0
   AND (SELECT count(m) FROM (SELECT {dimension}, AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS m
       FROM ledger GROUP BY {dimension})) > 0;
----
true

endloop

query II
SELECT segment, AGG(margin) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY segment ORDER BY segment;
----
enterprise	0.8311111111111111
startup	NULL

# inside arithmetic
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.month, AGG(margin) FILTER (WHERE account.segment = 'enterprise') * 100 - AGG(cost)
     FROM ledger GROUP BY metric_time.month
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_margin * 100 - cost AS m))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_margin * 100 - cost AS m)
     EXCEPT ALL
     SELECT metric_time.month, AGG(margin) FILTER (WHERE account.segment = 'enterprise') * 100 - AGG(cost)
     FROM ledger GROUP BY metric_time.month)
  )) = 0
   AND (SELECT count(m) FROM (SELECT metric_time.month,
       AGG(margin) FILTER (WHERE account.segment = 'enterprise') * 100 - AGG(cost) AS m
       FROM ledger GROUP BY metric_time.month)) > 0;
----
true

# inside time_shift(): the condition reads the stored rows, the shift moves the dimensions
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.month, time_shift(AGG(margin) FILTER (WHERE account.segment = 'enterprise'), INTERVAL 1 YEAR)
     FROM ledger GROUP BY metric_time.month
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_margin_ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_margin_ly)
     EXCEPT ALL
     SELECT metric_time.month, time_shift(AGG(margin) FILTER (WHERE account.segment = 'enterprise'), INTERVAL 1 YEAR)
     FROM ledger GROUP BY metric_time.month)
  )) = 0
   AND (SELECT count(m) FROM (SELECT metric_time.month,
       time_shift(AGG(margin) FILTER (WHERE account.segment = 'enterprise'), INTERVAL 1 YEAR) AS m
       FROM ledger GROUP BY metric_time.month)) > 0;
----
true

# ... and cumulative()
query III
SELECT metric_time.year, cumulative(AGG(revenue) FILTER (WHERE account.segment = 'enterprise')) AS running,
       AGG(enterprise_revenue)
FROM ledger GROUP BY metric_time.year ORDER BY 1;
----
2025-01-01	1400	1400
2026-01-01	4500	3100

# in HAVING
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
     HAVING AGG(revenue) FILTER (WHERE account.segment = 'enterprise') > 700
     EXCEPT ALL
     SELECT month, revenue FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue, enterprise_revenue)
     WHERE enterprise_revenue > 700)
    UNION ALL
    (SELECT month, revenue FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue, enterprise_revenue)
     WHERE enterprise_revenue > 700
     EXCEPT ALL
     SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
     HAVING AGG(revenue) FILTER (WHERE account.segment = 'enterprise') > 700)
  )) = 0
   AND (SELECT count(*) FROM (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
       HAVING AGG(revenue) FILTER (WHERE account.segment = 'enterprise') > 700)) = 3;
----
true

# in a window, in QUALIFY and in ORDER BY
query II
SELECT country, RANK() OVER (ORDER BY AGG(margin) FILTER (WHERE account.segment = 'enterprise') DESC NULLS LAST) AS r
FROM ledger GROUP BY country ORDER BY country;
----
DE	2
FR	1
US	3

query II
SELECT segment, AGG(revenue) FILTER (WHERE account.country = 'FR') / SUM(AGG(revenue)) OVER () AS fr_share
FROM ledger GROUP BY segment ORDER BY segment;
----
enterprise	0.5042016806722689
startup	0.09243697478991597

query II
SELECT country, AGG(revenue) FROM ledger GROUP BY ALL
QUALIFY RANK() OVER (ORDER BY AGG(revenue) FILTER (WHERE account.segment = 'enterprise') DESC NULLS LAST) <= 2
ORDER BY AGG(revenue) FILTER (WHERE account.segment = 'enterprise') DESC;
----
FR	3550
DE	1500

# a semi-additive metric filters its rows like the query's WHERE (as its metric FILTER does): a group without
# matching rows disappears when no other metric produces it
query II
SELECT country, AGG(balance) FILTER (WHERE segment = 'enterprise') FROM ledger GROUP BY country ORDER BY country;
----
DE	800
FR	1200

query II
SELECT country, AGG(enterprise_balance) FROM ledger GROUP BY country ORDER BY country;
----
DE	800
FR	1200

query III
SELECT country, AGG(balance) FILTER (WHERE segment = 'enterprise'), AGG(balance) FROM ledger GROUP BY country
ORDER BY country;
----
DE	800	800
FR	1200	1200
US	NULL	450

# the same metric with and without FILTER, or with different conditions, are distinct items
query IIII
SELECT country, AGG(revenue), AGG(revenue) FILTER (WHERE account.segment = 'enterprise'),
       AGG(revenue) FILTER (WHERE account.country = 'FR')
FROM ledger GROUP BY country ORDER BY country;
----
DE	1500	1500	NULL
FR	3550	3000	3550
US	900	NULL	NULL

query IIII
SELECT country, AGG(revenue) FILTER (WHERE account.country = 'FR'),
       AGG(revenue) FILTER (WHERE account.segment = 'enterprise'), AGG(revenue)
FROM ledger GROUP BY country ORDER BY country;
----
DE	NULL	1500	1500
FR	3550	3000	3550
US	NULL	NULL	900

# ... equal ones share one item
query II
SELECT contains(sql, '__sv_m1'), contains(sql, '__sv_m2') FROM semantic_view_sql('SELECT country,
    AGG(revenue) FILTER (WHERE account.segment = ''enterprise'') AS a,
    AGG(revenue) FILTER (WHERE account.segment = ''enterprise'') + 1 AS b, AGG(revenue) AS c
  FROM ledger GROUP BY country');
----
true	false

# an ad-hoc aggregate keeps its native FILTER
query III
SELECT country, AGG(revenue) FILTER (WHERE account.segment = 'enterprise'),
       SUM(invoices.amount) FILTER (WHERE account.segment = 'enterprise')
FROM ledger GROUP BY country ORDER BY country;
----
DE	1500	1500
FR	3000	3000
US	NULL	NULL

# the condition's names are resolved like the rest of the query: view-qualified, bare or quoted
query IIII
SELECT l.country, AGG(revenue) FILTER (WHERE l.segment = 'enterprise'),
       AGG(revenue) FILTER (WHERE l.account.segment = 'enterprise'),
       AGG(revenue) FILTER (WHERE "account.segment" = 'enterprise')
FROM ledger AS l GROUP BY l.country ORDER BY 1;
----
DE	1500	1500	1500
FR	3000	3000	3000
US	NULL	NULL	NULL

#===--------------------------------------------------------------------===#
# Errors
#===--------------------------------------------------------------------===#

# the condition is row-level
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS AGG(margin) FILTER (WHERE invoices.revenue > 0) AS x);
----
<REGEX>:.*Invalid metric "x": FILTER must be a row-level condition \(dimensions, facts and columns only\).*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS AGG(revenue) FILTER (WHERE SUM(invoices.amount) > 0) AS x);
----
FILTER must be a row-level condition

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS AGG(revenue) FILTER (WHERE row_number() OVER () > 1) AS x);
----
FILTER must be a row-level condition

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS AGG(revenue) FILTER (WHERE AGG(account.segment) = 'x') AS x);
----
FILTER must be a row-level condition

# every table the condition reads is reachable from each aggregate
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS AGG(margin) FILTER (WHERE invoices.amount > 500) AS x);
----
<REGEX>:.*Invalid metric "x": FILTER \(WHERE \(?invoices\.amount > 500\)?\) references logical table "invoices", which is not reachable from "costs".*

# AGG() wraps one metric
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(DISTINCT margin) AS x);
----
<REGEX>:.*Invalid metric "x": AGG\(\) takes exactly one metric.*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(margin, cost) AS x);
----
AGG() takes exactly one metric

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(margin ORDER BY cost) AS x);
----
AGG() takes exactly one metric

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS AGG(account.segment) AS x);
----
AGG() requires a metric; "account.segment" is not a metric

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS SUM(AGG(revenue)) AS x);
----
AGG() cannot be used inside an aggregate

# ... in METRICS only
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS AGG(margin) FILTER (WHERE account.segment = 'enterprise') AS x);
----
<REGEX>:.*Invalid dimension "x": AGG\(\) is only allowed in METRICS.*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue
  WHERE AGG(margin) FILTER (WHERE account.segment = 'enterprise') > 0);
----
<REGEX>:.*Invalid WHERE clause: AGG\(\) is only allowed in METRICS.*

# the transforms take their FILTER on the aggregate or AGG() inside them
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(margin, INTERVAL 1 YEAR) FILTER (WHERE account.segment = 'enterprise') AS x);
----
<REGEX>:.*time_shift\(AGG\(<metric>\) FILTER \(WHERE \.\.\.\), \.\.\.\).*

# the internal filter marker cannot be written
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS __sv_filter(0, revenue) AS x);
----
function "__sv_filter" is reserved for internal use

# AGG() is not a window function, with or without FILTER
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.country
  METRICS AGG(margin) FILTER (WHERE account.segment = 'enterprise') OVER () AS x);
----
<REGEX>:.*Invalid metric "x": AGG\(\) cannot be used as a window function; apply the window to it instead, as in SUM\(AGG\(\.\.\.\)\) OVER \(\.\.\.\).*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.country METRICS AGG(margin) OVER () AS x);
----
AGG() cannot be used as a window function

# by name
statement error
SELECT country, AGG(margin) FILTER (WHERE account.segment = 'enterprise') OVER () FROM ledger GROUP BY country;
----
AGG() cannot be used as a window function when querying semantic view "ledger" by name

statement error
SELECT country, AGG(DISTINCT margin) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY country;
----
AGG() takes exactly one metric

statement error
SELECT country, AGG(margin, cost) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY country;
----
AGG() takes exactly one metric

statement error
SELECT country, AGG(margin ORDER BY cost) FROM ledger GROUP BY country;
----
AGG() takes exactly one metric

statement error
SELECT country, AGG(m := margin) FROM ledger GROUP BY country;
----
AGG() takes exactly one metric

statement error
SELECT country, AGG(account.segment) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY country;
----
AGG() requires a metric; "account.segment" is not a metric

statement error
SELECT country, AGG(revenue) FILTER (WHERE AGG(cost) > 0) FROM ledger GROUP BY country;
----
FILTER must be a row-level condition

statement error
SELECT country, AGG(margin) FILTER (WHERE invoices.amount > 500) FROM ledger GROUP BY country;
----
references logical table "invoices", which is not reachable from "costs"

statement error
SELECT country, time_shift(AGG(revenue) FILTER (WHERE AGG(cost) > 0), INTERVAL 1 YEAR) FROM ledger GROUP BY country;
----
FILTER must be a row-level condition

#===--------------------------------------------------------------------===#
# Materializations
#===--------------------------------------------------------------------===#

# the condition is AND-ed into the stored aggregate, so a query-time filter can be materialized; queries filtering
# the same metric with the same condition, at query time or in the definition, read it
statement ok
ALTER SEMANTIC VIEW ledger SET MAX_STALENESS = 3600;

statement ok
ALTER SEMANTIC VIEW ledger ADD MATERIALIZATION enterprise AS
  DIMENSIONS account.country METRICS AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS enterprise_revenue;

query II
SELECT metrics, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN ledger);
----
[enterprise_revenue]	true

query III
SELECT
  (SELECT sql ILIKE '%ledger__enterprise__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger
     DIMENSIONS account.country METRICS AGG(revenue) FILTER (WHERE account.segment = ''enterprise'') AS e)')),
  (SELECT sql ILIKE '%ledger__enterprise__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger
     DIMENSIONS account.country METRICS enterprise_revenue)')),
  (SELECT sql ILIKE '%ledger__enterprise__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger
     DIMENSIONS account.country METRICS revenue)'));
----
true	true	false

query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS account.country
  METRICS AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS e, enterprise_revenue)
ORDER BY country;
----
DE	1500	1500
FR	3000	3000
US	NULL	NULL

# by name
query I
SELECT sql ILIKE '%ledger__enterprise__0%' FROM semantic_view_sql('SELECT country,
    AGG(revenue) FILTER (WHERE account.segment = ''enterprise'') FROM ledger GROUP BY country');
----
true

query II
SELECT country, AGG(revenue) FILTER (WHERE account.segment = 'enterprise') FROM ledger GROUP BY country
ORDER BY country;
----
DE	1500
FR	3000
US	NULL

# a monthly materialization of the query-time filtered metric serves the metric defined with that FILTER
statement ok
ALTER SEMANTIC VIEW ledger ADD MATERIALIZATION mf AS
  DIMENSIONS metric_time.month METRICS AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS er;

query II
SELECT metrics, usable FROM (SHOW SEMANTIC MATERIALIZATIONS LIKE 'mf' IN ledger);
----
[er]	true

query III
SELECT
  (SELECT sql ILIKE '%__semantic_materializations%ledger__mf__0%' FROM semantic_view_sql('SELECT * FROM
     SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue)')),
  (SELECT sql ILIKE '%__semantic_materializations%ledger__mf__0%' FROM semantic_view_sql('SELECT metric_time.month,
     AGG(revenue) FILTER (WHERE account.segment = ''enterprise'') FROM ledger GROUP BY metric_time.month')),
  (SELECT sql ILIKE '%__semantic_materializations%' FROM semantic_view_sql('SELECT * FROM
     SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue)'));
----
true	true	false

statement ok
CREATE TEMP TABLE from_materialization AS
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue);

statement ok
CREATE TEMP TABLE by_name_from_materialization AS
SELECT metric_time.month, AGG(revenue) FILTER (WHERE account.segment = 'enterprise') AS er
FROM ledger GROUP BY metric_time.month;

statement ok
SET semantic_view_materializations = false;

query I
SELECT (SELECT sql NOT ILIKE '%__semantic_materializations%' FROM semantic_view_sql('SELECT * FROM
          SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue)'))
   AND (SELECT count(*) FROM (
         (SELECT * FROM from_materialization
          EXCEPT ALL
          SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue))
         UNION ALL
         (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue)
          EXCEPT ALL
          SELECT * FROM from_materialization)
         UNION ALL
         (SELECT * FROM by_name_from_materialization
          EXCEPT ALL
          SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue))
         UNION ALL
         (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS enterprise_revenue)
          EXCEPT ALL
          SELECT * FROM by_name_from_materialization)
       )) = 0
   AND (SELECT count(enterprise_revenue) FROM from_materialization) = 4;
----
true

statement ok
RESET semantic_view_materializations;

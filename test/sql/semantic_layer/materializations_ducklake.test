# the materialized answers equal the sources after all these changes
statement ok
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION customers;

loop setting 0 2

statement ok
SET semantic_view_materializations = ${setting};

query IIIIIII
SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment METRICS o.revenue, o.order_count, o.qty_count, o.avg_qty, o.max_amount, o.min_amount) ORDER BY 1 NULLS LAST;
----
enterprise	11.00	1	1	1.0	11.00	11.00
retail	21.00	2	1	1.0	20.00	1.00
startup	25.00	2	2	2.0	13.00	12.00
NULL	11.00	3	2	1.0	7.00	1.00

query III
SELECT * FROM SEMANTIC_VIEW(shop METRICS o.revenue, o.order_count, o.max_amount);
----
68.00	8	20.00

query II
SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment METRICS c.customer_count) ORDER BY 1 NULLS LAST;
----
enterprise	1
retail	2
startup	1

endloop

statement ok
RESET semantic_view_materializations;

query I
SELECT sql ILIKE '%shop__totals__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(shop METRICS o.revenue, o.order_count, o.max_amount)');
----
true

# expired change history: AUTO falls back to a full rebuild, INCREMENTAL refuses
statement ok
INSERT INTO lake.orders VALUES (13, 1, 2.00, 1);

statement ok
CALL ducklake_expire_snapshots('lake', older_than => (now()::TIMESTAMP + INTERVAL 1 HOUR)::TIMESTAMPTZ);

statement error
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION incr;
----
cannot be refreshed incrementally: the changes since snapshot

query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION totals;
----
<REGEX>:Materialization totals refreshed \(FULL: the changes since snapshot \d+ of lake are no longer available\)\.

# DDL on another table of the catalog does not prevent incremental refreshes
statement ok
CREATE TABLE lake.unrelated (x INTEGER);

statement ok
ALTER TABLE lake.unrelated ADD COLUMN y INTEGER;

statement ok
INSERT INTO lake.orders VALUES (14, 1, 0.00, 1);

query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION totals;
----
Materialization totals refreshed (INCREMENTAL: 1 group(s) changed).

# a schema change of a source: full rebuild
statement ok
ALTER TABLE lake.orders ADD COLUMN note VARCHAR;

query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION totals;
----
Materialization totals refreshed (FULL: the definition of lake.main.orders changed since the last refresh).

query I
SELECT * FROM SEMANTIC_VIEW(shop METRICS o.revenue);
----
70.00

# nested aggregations over a child table are maintained incrementally (see materializations_nested.test)
statement ok
CREATE SEMANTIC VIEW child_view
  TABLES (o AS lake.orders PRIMARY KEY (id), c AS lake.customers PRIMARY KEY (id))
  RELATIONSHIPS (o (customer_id) REFERENCES c)
  FACTS (c.order_total AS SUM(o.amount))
  DIMENSIONS (c.segment AS segment)
  METRICS (c.avg_total AS AVG(c.order_total));

statement ok
ALTER SEMANTIC VIEW child_view ADD MATERIALIZATION m AS DIMENSIONS c.segment METRICS c.avg_total;

query II
SELECT incremental, not_incremental_reason FROM (SHOW SEMANTIC MATERIALIZATIONS IN child_view);
----
true	NULL

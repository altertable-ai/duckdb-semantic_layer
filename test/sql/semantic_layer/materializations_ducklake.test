# name: test/sql/semantic_layer/materializations_ducklake.test
# description: incremental refresh of materializations over DuckLake tables, checked against full rebuilds
# group: [semantic_layer]

require semantic_layer

require parquet

require ducklake

statement ok
ATTACH 'ducklake:__TEST_DIR__/materializations.ducklake' AS lake (DATA_PATH '__TEST_DIR__/materializations_data');

statement ok
CREATE TABLE lake.customers (id INTEGER, segment VARCHAR, country VARCHAR);

statement ok
INSERT INTO lake.customers VALUES (1, 'retail', 'FR'), (2, 'retail', 'US'), (3, 'pro', 'FR'), (4, 'pro', NULL);

statement ok
CREATE TABLE lake.orders (id INTEGER, customer_id INTEGER, amount DECIMAL(10, 2), qty INTEGER);

statement ok
INSERT INTO lake.orders VALUES (1, 1, 10.00, 1), (2, 1, 20.00, NULL), (3, 2, 5.50, 3), (4, 3, 100.00, 2), (5, 4, 1.00, 1), (6, 99, 7.00, 1);

statement ok
CREATE SEMANTIC VIEW shop
  TABLES (o AS lake.orders PRIMARY KEY (id), c AS lake.customers PRIMARY KEY (id))
  RELATIONSHIPS (o (customer_id) REFERENCES c)
  DIMENSIONS (c.segment AS segment, c.country AS country)
  METRICS (
    o.revenue AS SUM(amount),
    o.order_count AS COUNT(*),
    o.qty_count AS COUNT(qty),
    o.avg_qty AS AVG(qty),
    o.max_amount AS MAX(amount),
    o.min_amount AS MIN(amount),
    o.distinct_customers AS COUNT(DISTINCT customer_id),
    c.customer_count AS COUNT(*)
  );

# the same materialization twice: one always rebuilt, one maintained incrementally
statement ok
ALTER SEMANTIC VIEW shop ADD MATERIALIZATION full_copy REFRESH_MODE = FULL AS
  DIMENSIONS c.segment, c.country
  METRICS o.revenue, o.order_count, o.qty_count, o.avg_qty, o.max_amount, o.min_amount, o.distinct_customers;

statement ok
SET VARIABLE shop__full_copy__0 = (SELECT tables[1] FROM (SHOW SEMANTIC MATERIALIZATIONS IN shop) WHERE name = 'full_copy');

statement ok
ALTER SEMANTIC VIEW shop ADD MATERIALIZATION incr REFRESH_MODE = INCREMENTAL AS
  DIMENSIONS c.segment, c.country
  METRICS o.revenue, o.order_count, o.qty_count, o.avg_qty, o.max_amount, o.min_amount, o.distinct_customers;

statement ok
SET VARIABLE shop__incr__0 = (SELECT tables[1] FROM (SHOW SEMANTIC MATERIALIZATIONS IN shop) WHERE name = 'incr');

statement ok
ALTER SEMANTIC VIEW shop ADD MATERIALIZATION auto_copy AS
  DIMENSIONS c.segment, c.country
  METRICS o.revenue, o.order_count, o.qty_count, o.avg_qty, o.max_amount, o.min_amount, o.distinct_customers;

statement ok
SET VARIABLE shop__auto_copy__0 = (SELECT tables[1] FROM (SHOW SEMANTIC MATERIALIZATIONS IN shop) WHERE name = 'auto_copy');

statement ok
ALTER SEMANTIC VIEW shop ADD MATERIALIZATION totals AS METRICS o.revenue, o.order_count, o.max_amount;

statement ok
ALTER SEMANTIC VIEW shop ADD MATERIALIZATION customers AS DIMENSIONS c.segment METRICS c.customer_count;

query III
SELECT name, incremental, usable FROM (SHOW SEMANTIC MATERIALIZATIONS IN shop) ORDER BY name;
----
auto_copy	true	true
customers	true	true
full_copy	true	true
incr	true	true
totals	true	true

# fresh DuckLake materializations are used without MAX_STALENESS
query I
SELECT sql ILIKE '%shop__incr__0%' OR sql ILIKE '%shop__full_copy__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment METRICS o.revenue)');
----
true

# a changed source makes them stale: the sources are read until the next refresh
statement ok
INSERT INTO lake.orders VALUES (7, 2, 4.50, 1);

query II
SELECT usable, not_usable_reason FROM (SHOW SEMANTIC MATERIALIZATIONS IN shop) WHERE name = 'incr';
----
false	source lake.main.orders changed since its last refresh

query I
SELECT sql NOT ILIKE '%__semantic_materializations%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment METRICS o.revenue)');
----
true

query I
SELECT revenue FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment METRICS o.revenue) WHERE segment = 'retail';
----
40.00

# a prepared statement is planned again at every execution
statement ok
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION incr;

statement ok
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION full_copy;

statement ok
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION totals;

statement ok
PREPARE retail_revenue AS SELECT revenue FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment METRICS o.revenue) WHERE segment = 'retail';

query I
EXECUTE retail_revenue;
----
40.00

statement ok
INSERT INTO lake.orders VALUES (8, 1, 1.00, 1);

query I
EXECUTE retail_revenue;
----
41.00

# every kind of change; after each refresh the incremental copy equals the rebuilt one and the sources
statement ok
CREATE MACRO compare_copies() AS TABLE
  SELECT count(*) AS differences FROM (
    (SELECT * FROM query_table(getvariable('shop__incr__0')) EXCEPT ALL SELECT * FROM query_table(getvariable('shop__full_copy__0')))
    UNION ALL
    (SELECT * FROM query_table(getvariable('shop__full_copy__0')) EXCEPT ALL SELECT * FROM query_table(getvariable('shop__incr__0')))
    UNION ALL
    (SELECT * FROM query_table(getvariable('shop__auto_copy__0')) EXCEPT ALL SELECT * FROM query_table(getvariable('shop__full_copy__0')))
    UNION ALL
    (SELECT * FROM query_table(getvariable('shop__full_copy__0')) EXCEPT ALL SELECT * FROM query_table(getvariable('shop__auto_copy__0'))));

statement ok
CREATE MACRO hand_written() AS TABLE
  SELECT c.segment, c.country, sum(o.amount), count(*), count(o.qty), avg(o.qty), max(o.amount), min(o.amount), count(DISTINCT o.customer_id)
  FROM lake.orders o LEFT JOIN lake.customers c ON o.customer_id = c.id GROUP BY ALL;

# no change since the last refresh is a no-op (orders changed since, so refresh once first)
query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION incr;
----
Materialization incr refreshed (INCREMENTAL: 1 group(s) changed).

query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION incr;
----
Materialization incr is up to date.

statement ok
INSERT INTO lake.orders VALUES (9, 3, 50.00, 5), (10, NULL, 3.00, NULL);


query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION full_copy;
----
<REGEX>:Materialization full_copy refreshed \(FULL: FULL refresh requested\)\.

query I
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION incr;
----
<REGEX>:Materialization incr (refreshed \(INCREMENTAL: \d+ group\(s\) changed\)|is up to date)\.

statement ok
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION auto_copy;

statement ok
ALTER SEMANTIC VIEW shop REFRESH MATERIALIZATION totals INCREMENTAL;

query I
SELECT * FROM compare_copies();
----
0

query I
SELECT count(*) FROM (
  (SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment, c.country METRICS o.revenue, o.order_count, o.qty_count, o.avg_qty, o.max_amount, o.min_amount, o.distinct_customers)
   EXCEPT ALL SELECT * FROM hand_written())
  UNION ALL
  (SELECT * FROM hand_written()
   EXCEPT ALL SELECT * FROM SEMANTIC_VIEW(shop DIMENSIONS c.segment, c.country METRICS o.revenue, o.order_count, o.qty_count, o.avg_qty, o.max_amount, o.min_amount, o.distinct_customers)));
----
0



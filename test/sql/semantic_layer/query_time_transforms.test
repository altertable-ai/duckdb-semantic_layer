# name: test/sql/semantic_layer/query_time_transforms.test
# description: query-time metric transforms: time_shift(...) and cumulative(...)
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE accounts (account_id INTEGER, segment VARCHAR, country VARCHAR);

statement ok
INSERT INTO accounts VALUES (1, 'enterprise', 'FR'), (2, 'startup', 'US'), (3, 'enterprise', 'DE');

# 2025: no invoices in April, June, August and November; 2026: April has no 2025 counterpart
statement ok
CREATE TABLE invoices (invoice_id INTEGER, account_id INTEGER, invoiced_at DATE, amount INTEGER);

statement ok
INSERT INTO invoices VALUES
  (1, 1, '2025-01-05', 100), (2, 2, '2025-01-20', 200), (3, 3, '2025-02-11', 150), (4, 1, '2025-03-03', 120),
  (5, 2, '2025-05-17', 80), (6, 3, '2025-07-09', 300), (7, 1, '2025-09-30', 90), (8, 2, '2025-10-01', 60),
  (9, 3, '2025-12-31', 110),
  (10, 1, '2026-01-05', 130), (11, 3, '2026-01-28', 70), (12, 2, '2026-03-14', 210), (13, 1, '2026-04-02', 50),
  (14, 3, '2026-05-17', 140), (15, 2, '2026-07-09', 95), (16, 1, '2026-09-30', 160), (17, 3, '2026-10-01', 40),
  (18, 2, '2026-12-31', 75);

statement ok
CREATE TABLE balances (account_id INTEGER, as_of DATE, balance INTEGER);

statement ok
INSERT INTO balances VALUES
  (1, '2025-06-30', 1000), (2, '2025-06-30', 500), (3, '2025-12-31', 700),
  (1, '2026-06-30', 1200), (2, '2026-06-30', 450), (3, '2026-12-31', 800);

statement ok
CREATE SEMANTIC VIEW ledger
  TABLES (
    account AS accounts PRIMARY KEY (account_id),
    invoices PRIMARY KEY (invoice_id) TIME (invoiced_at),
    balances PRIMARY KEY (account_id, as_of)
  )
  RELATIONSHIPS (invoices (account_id) REFERENCES account, balances (account_id) REFERENCES account)
  DIMENSIONS (account.segment AS segment, invoices.invoice_date AS invoiced_at,
              invoices.invoice_month AS DATE_TRUNC('month', invoiced_at)::DATE, balances.as_of_day AS as_of)
  METRICS (
    invoices.revenue AS SUM(amount),
    invoices.avg_amount AS AVG(amount),
    invoices.revenue_ly OFFSET (metric_time.day BY INTERVAL 1 YEAR) AS revenue,
    invoices.revenue_lm_by_date OFFSET (invoices.invoice_date BY INTERVAL 1 MONTH) AS revenue,
    invoices.revenue_total CUMULATIVE (metric_time.day) AS SUM(amount),
    invoices.revenue_total_avg CUMULATIVE (metric_time.day AVERAGE) AS SUM(amount),
    invoices.revenue_mtd CUMULATIVE (metric_time.day TO MONTH) AS SUM(amount),
    invoices.revenue_7d CUMULATIVE (metric_time.day OVER INTERVAL 7 DAYS) AS SUM(amount),
    invoices.revenue_ytd_first CUMULATIVE (metric_time.day TO YEAR FIRST) AS SUM(amount),
    invoices.revenue_ytd_ly OFFSET (metric_time.day BY INTERVAL 1 YEAR) AS revenue_ytd_first,
    invoices.buyers_28d CUMULATIVE (metric_time.day OVER INTERVAL 28 DAYS) AS COUNT(DISTINCT account_id),
    balances.balance NON ADDITIVE BY (balances.as_of_day) AS SUM(balance),
    invoices.revenue_share AS invoices.revenue / SUM(invoices.revenue) OVER (PARTITION BY EXCLUDING account.segment)
  );

# the same invoices without TIME: no default dimension
statement ok
CREATE SEMANTIC VIEW ledger_untimed
  TABLES (invoices PRIMARY KEY (invoice_id))
  DIMENSIONS (invoices.invoice_date AS invoiced_at, invoices.invoice_month AS DATE_TRUNC('month', invoiced_at)::DATE)
  METRICS (
    invoices.revenue AS SUM(amount),
    invoices.revenue_lm OFFSET (invoices.invoice_date BY INTERVAL 1 MONTH) AS revenue
  );

#===--------------------------------------------------------------------===#
# time_shift(<metric>, <interval> [, dimension := <dimension>])
#===--------------------------------------------------------------------===#

# time_shift(m, i) computes what a metric defined with OFFSET (metric_time.day BY i) computes, at every grain
foreach grain day month year

query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment METRICS revenue_ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment METRICS revenue_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly)) > 0;
----
true

endloop

# ... and compiles to the same SQL
query I
SELECT (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly)'))
     = (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS revenue_ly)'));
----
true

# the WHERE clause reads the shifted rows
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly WHERE metric_time.year = DATE '2026-01-01')
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue_ly
       WHERE metric_time.year = DATE '2026-01-01'))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue_ly
       WHERE metric_time.year = DATE '2026-01-01')
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly WHERE metric_time.year = DATE '2026-01-01'))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS revenue_ly WHERE metric_time.year = DATE '2026-01-01')) > 0;
----
true

# growth over the 2026 months that have 2025 data
query II
SELECT count(*), count(*) FILTER (WHERE growth IS NULL)
FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS revenue / time_shift(revenue, INTERVAL 1 YEAR) - 1 AS growth WHERE metric_time.year = DATE '2026-01-01')
WHERE month IN (DATE '2026-01-01', DATE '2026-03-01', DATE '2026-05-01', DATE '2026-07-01', DATE '2026-09-01',
                DATE '2026-10-01', DATE '2026-12-01');
----
7	0

# inside an expression
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS revenue / time_shift(revenue, INTERVAL 1 YEAR) - 1 AS growth)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS revenue / revenue_ly - 1 AS growth))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS revenue / revenue_ly - 1 AS growth)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS revenue / time_shift(revenue, INTERVAL 1 YEAR) - 1 AS growth))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS revenue / time_shift(revenue, INTERVAL 1 YEAR) - 1 AS growth)) > 0;
----
true

# over an ad-hoc aggregate
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS revenue_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment METRICS revenue_ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment METRICS revenue_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS revenue_ly))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS revenue_ly)) > 0;
----
true

# nested shifts add up
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(time_shift(revenue, INTERVAL 1 YEAR), INTERVAL 1 YEAR) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 2 YEARS) AS r))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 2 YEARS) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(time_shift(revenue, INTERVAL 1 YEAR), INTERVAL 1 YEAR) AS r))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(time_shift(revenue, INTERVAL 1 YEAR), INTERVAL 1 YEAR) AS r)) > 0;
----
true

# the function name is case-insensitive
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS TIME_SHIFT(revenue, INTERVAL 1 YEAR) AS revenue_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue_ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS TIME_SHIFT(revenue, INTERVAL 1 YEAR) AS revenue_ly))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS TIME_SHIFT(revenue, INTERVAL 1 YEAR) AS revenue_ly)) > 0;
----
true

# a window function over a shifted metric
query I
SELECT count(*) > 0 FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
  METRICS RANK() OVER (PARTITION BY EXCLUDING account.segment ORDER BY time_shift(revenue, INTERVAL 1 YEAR)) AS r);
----
true

# ... ranks the shifted values
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS RANK() OVER (PARTITION BY EXCLUDING account.segment ORDER BY time_shift(revenue, INTERVAL 1 YEAR)) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS RANK() OVER (PARTITION BY EXCLUDING account.segment ORDER BY revenue_ly) AS r))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS RANK() OVER (PARTITION BY EXCLUDING account.segment ORDER BY revenue_ly) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS RANK() OVER (PARTITION BY EXCLUDING account.segment ORDER BY time_shift(revenue, INTERVAL 1 YEAR)) AS r))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
       METRICS RANK() OVER (PARTITION BY EXCLUDING account.segment ORDER BY time_shift(revenue, INTERVAL 1 YEAR)) AS r)) > 0;
----
true

# equal shifts share their block with the defined metric
query II
SELECT count(*) > 0, count(*) FILTER (WHERE revenue_ly IS DISTINCT FROM a OR a IS DISTINCT FROM b) = 0
FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS revenue_ly, time_shift(revenue, INTERVAL 1 YEAR) AS a, time_shift(revenue, INTERVAL 1 YEAR) AS b);
----
true	true

# an explicit dimension
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month
       METRICS time_shift(revenue, INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month METRICS revenue_lm_by_date AS r))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month METRICS revenue_lm_by_date AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month
       METRICS time_shift(revenue, INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS r))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month
       METRICS time_shift(revenue, INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS r)) > 0;
----
true

query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month
       METRICS time_shift(revenue, INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month METRICS revenue_lm AS r))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month METRICS revenue_lm AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month
       METRICS time_shift(revenue, INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS r))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month
       METRICS time_shift(revenue, INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS r)) > 0;
----
true

# the default dimension is metric_time.day
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR, dimension := metric_time.day) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS r))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR) AS r)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR, dimension := metric_time.day) AS r))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS time_shift(revenue, INTERVAL 1 YEAR, dimension := metric_time.day) AS r)) > 0;
----
true

# only in METRICS
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS time_shift(revenue, INTERVAL 1 YEAR) AS x);
----
time_shift() is only allowed in METRICS

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue
  WHERE time_shift(revenue, INTERVAL 1 YEAR) > 0);
----
time_shift() is only allowed in METRICS

statement error
SELECT * FROM SEMANTIC_VIEW(ledger FACTS time_shift(invoices.amount, INTERVAL 1 YEAR) AS x);
----
time_shift() is only allowed in METRICS

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS SUM(time_shift(invoices.amount, INTERVAL 1 YEAR)) AS x);
----
time_shift() cannot be used inside an aggregate

# no window function below the shift
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
  METRICS time_shift(revenue_share, INTERVAL 1 YEAR) AS x);
----
cannot contain a window function

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(SUM(invoices.amount) OVER (), INTERVAL 1 YEAR) AS x);
----
cannot contain a window function

# the dimension
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(revenue, INTERVAL 1 YEAR, dimension := metric_time.month) AS x);
----
<REGEX>:.*must be defined as a column.*valid dimensions:.*metric_time\.day.*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(revenue, INTERVAL 1 YEAR, dimension := account.segment) AS x);
----
cannot shift column

statement error
SELECT * FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month
  METRICS time_shift(revenue, INTERVAL 1 MONTH) AS x);
----
<REGEX>:.*needs dimension :=.*invoices\.invoice_date.*

# the arguments
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS time_shift(revenue) AS x);
----
time_shift(<metric>, <interval> [, dimension := <dimension>])

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(revenue, metric_time.day, INTERVAL 1 YEAR) AS x);
----
time_shift(<metric>, <interval> [, dimension := <dimension>])

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(revenue, INTERVAL 1 YEAR, dim := metric_time.day) AS x);
----
<REGEX>:.*unknown argument "dim".*dimension.*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS time_shift(revenue, INTERVAL 1 YEAR, dimension := metric_time.day, dimension := metric_time.day) AS x);
----
repeated argument "dimension"

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS time_shift(revenue, invoices.amount) AS x);
----
the interval must be a constant expression

statement error
PREPARE p AS SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS time_shift(revenue, $1) AS x);
----
the interval must be a constant expression

# definitions use OFFSET (...) / CUMULATIVE (...)
statement error
CREATE SEMANTIC VIEW bad TABLES (invoices PRIMARY KEY (invoice_id) TIME (invoiced_at))
  METRICS (invoices.revenue AS SUM(amount), invoices.x AS time_shift(revenue, INTERVAL 1 YEAR));
----
<REGEX>:.*time_shift\(\) is only allowed in queries.*OFFSET.*

statement error
CREATE SEMANTIC VIEW bad TABLES (invoices PRIMARY KEY (invoice_id) TIME (invoiced_at))
  METRICS (invoices.revenue AS SUM(amount), invoices.x AS cumulative(revenue));
----
<REGEX>:.*cumulative\(\) is only allowed in queries.*CUMULATIVE.*

# the internal transform markers cannot be written
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS __sv_offset(0, revenue) AS x);
----
function "__sv_offset" is reserved for internal use

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS __sv_offset(99, revenue) AS x);
----
function "__sv_offset" is reserved for internal use

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS "__SV_CUMULATIVE"(0, revenue) AS x);
----
function "__sv_cumulative" is reserved for internal use

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue
  WHERE __sv_offset(0, invoices.amount) > 0);
----
function "__sv_offset" is reserved for internal use

statement error
CREATE SEMANTIC VIEW bad TABLES (invoices PRIMARY KEY (invoice_id) TIME (invoiced_at))
  METRICS (invoices.revenue AS SUM(amount), invoices.x AS __sv_offset(0, revenue));
----
function "__sv_offset" is reserved for internal use

statement error
CREATE SEMANTIC VIEW bad TABLES (invoices PRIMARY KEY (invoice_id) TIME (invoiced_at))
  METRICS (invoices.x FILTER (WHERE main.__sv_offset(0, amount) > 0) AS SUM(amount));
----
function "__sv_offset" is reserved for internal use

#===--------------------------------------------------------------------===#
# cumulative(<metric> [, trailing_window := <interval> | to_date := '<date part>'] [, period := ...]
#            [, dimension := <dimension>])
#===--------------------------------------------------------------------===#

# cumulative(m, ...) computes what a metric defined with CUMULATIVE (metric_time.day ...) computes, at every grain
foreach grain day month year

# a running total
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue) AS revenue_total)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_total))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_total)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue) AS revenue_total))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue) AS revenue_total)) > 0;
----
true

# period := 'average'
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, period := 'average') AS revenue_total_avg)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_total_avg))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_total_avg)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, period := 'average') AS revenue_total_avg))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, period := 'average') AS revenue_total_avg)) > 0;
----
true

# to_date := <part>
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, to_date := 'month') AS revenue_mtd)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_mtd))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_mtd)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, to_date := 'month') AS revenue_mtd))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, to_date := 'month') AS revenue_mtd)) > 0;
----
true

# trailing_window := <interval>
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, trailing_window := INTERVAL 7 DAYS) AS revenue_7d)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_7d))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_7d)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, trailing_window := INTERVAL 7 DAYS) AS revenue_7d))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, trailing_window := INTERVAL 7 DAYS) AS revenue_7d)) > 0;
----
true

# to_date and period
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, to_date := 'year', period := 'first') AS revenue_ytd_first)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_ytd_first))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_ytd_first)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, to_date := 'year', period := 'first') AS revenue_ytd_first))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, to_date := 'year', period := 'first') AS revenue_ytd_first)) > 0;
----
true

# names and values are case-insensitive, in any order
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS CUMULATIVE(revenue, PERIOD := 'FIRST', TO_DATE := 'YEAR') AS revenue_ytd_first)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_ytd_first))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_ytd_first)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS CUMULATIVE(revenue, PERIOD := 'FIRST', TO_DATE := 'YEAR') AS revenue_ytd_first))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS CUMULATIVE(revenue, PERIOD := 'FIRST', TO_DATE := 'YEAR') AS revenue_ytd_first)) > 0;
----
true

# over an ad-hoc aggregate
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(COUNT(DISTINCT invoices.account_id), trailing_window := INTERVAL 28 DAYS) AS buyers_28d)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS buyers_28d))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS buyers_28d)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(COUNT(DISTINCT invoices.account_id), trailing_window := INTERVAL 28 DAYS) AS buyers_28d))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(COUNT(DISTINCT invoices.account_id), trailing_window := INTERVAL 28 DAYS) AS buyers_28d)) > 0;
----
true

# shifting a cumulative
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS time_shift(cumulative(revenue, to_date := 'year', period := 'first'), INTERVAL 1 YEAR) AS revenue_ytd_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_ytd_ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_ytd_ly)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS time_shift(cumulative(revenue, to_date := 'year', period := 'first'), INTERVAL 1 YEAR) AS revenue_ytd_ly))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS time_shift(cumulative(revenue, to_date := 'year', period := 'first'), INTERVAL 1 YEAR) AS revenue_ytd_ly)) > 0;
----
true

# an explicit dimension
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, dimension := metric_time.day) AS revenue_total)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_total))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS revenue_total)
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, dimension := metric_time.day) AS revenue_total))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}, account.segment
       METRICS cumulative(revenue, dimension := metric_time.day) AS revenue_total)) > 0;
----
true

endloop

# the WHERE clause does not remove earlier rows from the running total
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS cumulative(revenue) AS revenue_total WHERE metric_time.month >= DATE '2026-03-01')
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue_total WHERE metric_time.month >= DATE '2026-03-01'))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue_total WHERE metric_time.month >= DATE '2026-03-01')
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS cumulative(revenue) AS revenue_total WHERE metric_time.month >= DATE '2026-03-01'))
  )) = 0
   AND (SELECT count(*) FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS cumulative(revenue) AS revenue_total WHERE metric_time.month >= DATE '2026-03-01')) > 0;
----
true

# ... which really are counted: March 2026 holds every invoice up to it
query I
SELECT revenue_total FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue) AS revenue_total WHERE metric_time.month >= DATE '2026-03-01')
WHERE month = DATE '2026-03-01';
----
1620


# ... and compiles to the same SQL
query I
SELECT (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS cumulative(revenue, to_date := ''month'') AS revenue_mtd)'))
     = (SELECT sql FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
          METRICS revenue_mtd)'));
----
true

# equal clauses share their block with the defined metric
query II
SELECT count(*) > 0, count(*) FILTER (WHERE revenue_mtd IS DISTINCT FROM a) = 0
FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS revenue_mtd, cumulative(revenue, to_date := 'month') AS a);
----
true	true

# composition: no OFFSET, CUMULATIVE or NON ADDITIVE BY below a cumulative
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(revenue_ly) AS x);
----
cannot reference metric "invoices.revenue_ly", which uses OFFSET

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(time_shift(revenue, INTERVAL 1 YEAR)) AS x);
----
cannot contain time_shift()

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(revenue_total) AS x);
----
cannot reference metric "invoices.revenue_total", which uses CUMULATIVE

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(cumulative(revenue)) AS x);
----
cannot contain cumulative()

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(balance) AS x);
----
cannot reference metric "balances.balance", which uses NON ADDITIVE BY

# no window function below the cumulative
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month, account.segment
  METRICS cumulative(revenue_share) AS x);
----
cannot contain a window function

# 'average' averages a single aggregate
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue / avg_amount, period := 'average') AS x);
----
requires a metric computed from a single aggregate

# the arguments
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, trailing_window := 42) AS x);
----
trailing_window must be an interval

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, trailing_window := invoices.amount) AS x);
----
the window must be a constant expression

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, trailing_window := INTERVAL 7 DAYS, to_date := 'month') AS x);
----
trailing_window and to_date cannot be combined

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, to_date := 'fortnight') AS x);
----
"fortnight" is not a date part to truncate to

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(revenue, to_date := 42) AS x);
----
to_date must be

# a non-constant argument is not printed (it holds internal markers)
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(revenue, to_date := month) AS x);
----
<REGEX>:.*to_date must be a date part string \(e\.g\. to_date := 'month'\)\n.*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, period := 'median') AS x);
----
period must be 'first', 'last' or 'average'

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(revenue, 'month') AS x);
----
cumulative(<metric> [, trailing_window := <interval> | to_date := '<date part>'] [, period := 'first' | 'last' | 'average'] [, dimension := <dimension>])

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS cumulative(revenue, metric_time.day) AS x);
----
cumulative(<metric> [, trailing_window := <interval> | to_date := '<date part>'] [, period := 'first' | 'last' | 'average'] [, dimension := <dimension>])

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, window_size := INTERVAL 7 DAYS) AS x);
----
<REGEX>:.*unknown argument "window_size".*trailing_window.*

# the dimension
statement error
SELECT * FROM SEMANTIC_VIEW(ledger_untimed DIMENSIONS invoices.invoice_month METRICS cumulative(revenue) AS x);
----
<REGEX>:.*cumulative\(\) needs dimension :=.*invoices\.invoice_date.*

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
  METRICS cumulative(revenue, dimension := invoices.invoice_month) AS x);
----
<REGEX>:.*cumulative\(\): dimension "invoices\.invoice_month" must be defined as a column.*valid dimensions:.*invoices\.invoice_date.*

# only in METRICS
statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue WHERE cumulative(revenue) > 0);
----
cumulative() is only allowed in METRICS

statement error
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS SUM(cumulative(invoices.amount)) AS x);
----
cumulative() cannot be used inside an aggregate

#===--------------------------------------------------------------------===#
# queries by name: SELECT ... FROM <semantic view> GROUP BY ...
#===--------------------------------------------------------------------===#

# a transform call is one metric item, with the AGG() calls of its first argument unwrapped
foreach grain day month year

query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.{grain}, AGG(revenue), time_shift(AGG(revenue), INTERVAL 1 YEAR) AS ly
     FROM ledger GROUP BY metric_time.{grain}
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly)
     EXCEPT ALL
     SELECT metric_time.{grain}, AGG(revenue), time_shift(AGG(revenue), INTERVAL 1 YEAR) AS ly
     FROM ledger GROUP BY metric_time.{grain})
  )) = 0
   AND (SELECT count(*) FROM (SELECT metric_time.{grain}, AGG(revenue), time_shift(AGG(revenue), INTERVAL 1 YEAR) AS ly
     FROM ledger GROUP BY metric_time.{grain})) > 0;
----
true

# GROUP BY ALL does not group by the transform call
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.{grain}, AGG(revenue), time_shift(AGG(revenue), INTERVAL 1 YEAR) AS ly
     FROM ledger GROUP BY ALL
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.{grain}
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly)
     EXCEPT ALL
     SELECT metric_time.{grain}, AGG(revenue), time_shift(AGG(revenue), INTERVAL 1 YEAR) AS ly
     FROM ledger GROUP BY ALL)
  )) = 0
   AND (SELECT count(*) FROM (SELECT metric_time.{grain}, AGG(revenue), time_shift(AGG(revenue), INTERVAL 1 YEAR) AS ly
     FROM ledger GROUP BY ALL)) > 0;
----
true

endloop

# arithmetic around the call stays in the outer query
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.month, AGG(revenue) / time_shift(AGG(revenue), INTERVAL 1 YEAR) - 1 AS growth
     FROM ledger GROUP BY metric_time.month
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue / time_shift(revenue, INTERVAL 1 YEAR) - 1 AS growth))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue / time_shift(revenue, INTERVAL 1 YEAR) - 1 AS growth)
     EXCEPT ALL
     SELECT metric_time.month, AGG(revenue) / time_shift(AGG(revenue), INTERVAL 1 YEAR) - 1 AS growth
     FROM ledger GROUP BY metric_time.month)
  )) = 0
   AND (SELECT count(growth) FROM (SELECT metric_time.month, AGG(revenue) / time_shift(AGG(revenue), INTERVAL 1 YEAR) - 1
     AS growth FROM ledger GROUP BY metric_time.month)) > 0;
----
true

# cumulative(...) with a named argument, and a shift of an ad-hoc aggregate
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.day, cumulative(AGG(revenue), to_date := 'month') AS mtd,
            time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS amount_ly
     FROM ledger GROUP BY metric_time.day
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.day
       METRICS cumulative(revenue, to_date := 'month') AS mtd,
               time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS amount_ly))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.day
       METRICS cumulative(revenue, to_date := 'month') AS mtd,
               time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS amount_ly)
     EXCEPT ALL
     SELECT metric_time.day, cumulative(AGG(revenue), to_date := 'month') AS mtd,
            time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS amount_ly
     FROM ledger GROUP BY metric_time.day)
  )) = 0
   AND (SELECT count(*) FROM (SELECT metric_time.day, cumulative(AGG(revenue), to_date := 'month') AS mtd,
            time_shift(SUM(invoices.amount), INTERVAL 1 YEAR) AS amount_ly
     FROM ledger GROUP BY metric_time.day)) > 0;
----
true

# named arguments resolve in the semantic query: invoices.invoice_date is not grouped
query I
SELECT (SELECT count(*) FROM (
    (SELECT invoices.invoice_month,
            time_shift(AGG(revenue), INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS lm
     FROM ledger GROUP BY invoices.invoice_month
     EXCEPT ALL
     SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month METRICS revenue_lm_by_date))
    UNION ALL
    (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS invoices.invoice_month METRICS revenue_lm_by_date)
     EXCEPT ALL
     SELECT invoices.invoice_month,
            time_shift(AGG(revenue), INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS lm
     FROM ledger GROUP BY invoices.invoice_month)
  )) = 0
   AND (SELECT count(*) FROM (SELECT invoices.invoice_month,
            time_shift(AGG(revenue), INTERVAL 1 MONTH, dimension := invoices.invoice_date) AS lm
     FROM ledger GROUP BY invoices.invoice_month)) > 0;
----
true

# in HAVING
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
     HAVING time_shift(AGG(revenue), INTERVAL 1 YEAR) > 0
     EXCEPT ALL
     SELECT month, revenue FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly) WHERE ly > 0)
    UNION ALL
    (SELECT month, revenue FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly) WHERE ly > 0
     EXCEPT ALL
     SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
     HAVING time_shift(AGG(revenue), INTERVAL 1 YEAR) > 0)
  )) = 0
   AND (SELECT count(*) FROM (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
     HAVING time_shift(AGG(revenue), INTERVAL 1 YEAR) > 0)) > 0;
----
true

# AGG() takes a metric, not a transform call
statement error
SELECT metric_time.month, AGG(time_shift(revenue, INTERVAL 1 YEAR)) FROM ledger GROUP BY metric_time.month;
----
AGG() takes exactly one metric

# a metric inside a transform call needs AGG() too
statement error
SELECT metric_time.month, time_shift(revenue, INTERVAL 1 YEAR) FROM ledger GROUP BY metric_time.month;
----
Metric "revenue" must be used with AGG()

statement error
SELECT metric_time.month, cumulative(revenue) FROM ledger GROUP BY metric_time.month;
----
Metric "revenue" must be used with AGG()

statement error
SELECT metric_time.month, time_shift(AGG(revenue) + revenue, INTERVAL 1 YEAR) FROM ledger GROUP BY metric_time.month;
----
Metric "revenue" must be used with AGG()

# in ORDER BY
query I
SELECT (SELECT count(*) FROM (
    (SELECT * FROM (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
       ORDER BY time_shift(AGG(revenue), INTERVAL 1 YEAR) DESC NULLS LAST, metric_time.month LIMIT 3)
     EXCEPT ALL
     SELECT month, revenue FROM (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly) ORDER BY ly DESC NULLS LAST, month LIMIT 3))
    UNION ALL
    (SELECT month, revenue FROM (SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month
       METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly) ORDER BY ly DESC NULLS LAST, month LIMIT 3)
     EXCEPT ALL
     SELECT * FROM (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
       ORDER BY time_shift(AGG(revenue), INTERVAL 1 YEAR) DESC NULLS LAST, metric_time.month LIMIT 3))
  )) = 0
   AND (SELECT count(*) FROM (SELECT * FROM (SELECT metric_time.month, AGG(revenue) FROM ledger GROUP BY metric_time.month
       ORDER BY time_shift(AGG(revenue), INTERVAL 1 YEAR) DESC NULLS LAST, metric_time.month LIMIT 3))) > 0;
----
true

# nested transforms
query I
SELECT (SELECT count(*) FROM (
    (SELECT metric_time.month,
            time_shift(cumulative(AGG(revenue), to_date := 'year', period := 'first'), INTERVAL 1 YEAR)
     FROM ledger GROUP BY metric_time.month
     EXCEPT ALL
     SELECT metric_time.month, AGG(revenue_ytd_ly) FROM ledger GROUP BY metric_time.month)
    UNION ALL
    (SELECT metric_time.month, AGG(revenue_ytd_ly) FROM ledger GROUP BY metric_time.month
     EXCEPT ALL
     SELECT metric_time.month,
            time_shift(cumulative(AGG(revenue), to_date := 'year', period := 'first'), INTERVAL 1 YEAR)
     FROM ledger GROUP BY metric_time.month)
  )) = 0
   AND (SELECT count(*) FROM (SELECT metric_time.month,
            time_shift(cumulative(AGG(revenue), to_date := 'year', period := 'first'), INTERVAL 1 YEAR) AS x
     FROM ledger GROUP BY metric_time.month) WHERE x IS NOT NULL) > 0;
----
true

# materializations
statement error
ALTER SEMANTIC VIEW ledger ADD MATERIALIZATION m1 AS DIMENSIONS metric_time.month
  METRICS time_shift(revenue, INTERVAL 1 YEAR) AS ly;
----
cannot be materialized

statement ok
ALTER SEMANTIC VIEW ledger ADD MATERIALIZATION m2 AS DIMENSIONS metric_time.month METRICS revenue;

statement ok
ALTER SEMANTIC VIEW ledger SET MAX_STALENESS = 3600;

# a mixed query reads the materialization only for the plain block
query I
SELECT len(sql) - len(replace(sql, '__semantic_materializations', '')) = len('__semantic_materializations')
FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly)');
----
true

statement ok
CREATE TABLE mixed_on AS SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly);

statement ok
SET semantic_view_materializations = false;

statement ok
CREATE TABLE mixed_off AS SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS metric_time.month METRICS revenue, time_shift(revenue, INTERVAL 1 YEAR) AS ly);

statement ok
RESET semantic_view_materializations;

query I
SELECT (SELECT count(*) FROM ((SELECT * FROM mixed_on EXCEPT ALL SELECT * FROM mixed_off)
  UNION ALL (SELECT * FROM mixed_off EXCEPT ALL SELECT * FROM mixed_on))) = 0
  AND (SELECT count(*) FROM mixed_on) > 0;
----
true

# catalog entries and the error outside semantic queries
query TTT
SELECT function_name, function_type, parameters::VARCHAR FROM duckdb_functions()
WHERE function_name IN ('time_shift', 'cumulative') ORDER BY ALL;
----
cumulative	scalar	[metric, trailing_window, to_date, period, dimension]
time_shift	scalar	[metric, interval, dimension]

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('time_shift', 'cumulative') AND description <> '' AND len(examples) > 0;
----
2

statement error
SELECT time_shift(1, INTERVAL 1 YEAR);
----
time_shift() can only be used in the METRICS of a semantic query

statement error
SELECT cumulative(1);
----
cumulative() can only be used in the METRICS of a semantic query

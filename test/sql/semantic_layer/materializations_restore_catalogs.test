# name: test/sql/semantic_layer/materializations_restore_catalogs.test
# description: CREATE SEMANTIC VIEW searches for stored materializations only in the databases the view uses
# group: [semantic_layer]

require semantic_layer

load __TEST_DIR__/restore_catalogs.db

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_src.db' AS src;

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_sub.db' AS sub;

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_other.db' AS other;

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_views.db' AS views;

statement ok
CREATE TABLE t (id INTEGER, amount INTEGER);

statement ok
INSERT INTO t VALUES (1, 10), (2, 5);

statement ok
CREATE TABLE src.u (id INTEGER, t_id INTEGER);

statement ok
INSERT INTO src.u VALUES (1, 1), (2, 1), (3, 2);

statement ok
CREATE TABLE sub.w (id INTEGER, weight INTEGER);

statement ok
INSERT INTO sub.w VALUES (1, 7);

statement ok
CREATE VIEW views.x AS SELECT * FROM sub.w;

# t lives in the view's database, u in src, w is read by a query and x through a view stored in views; other is not
# used by the view
statement ok
CREATE SEMANTIC VIEW v
  TABLES (t AS t PRIMARY KEY (id), u AS src.u PRIMARY KEY (id), w AS (SELECT * FROM sub.w) PRIMARY KEY (id),
    x AS views.x PRIMARY KEY (id))
  RELATIONSHIPS (u (t_id) REFERENCES t)
  METRICS (t.total AS SUM(amount), u.n AS COUNT(*), w.weights AS SUM(weight), x.xs AS COUNT(*));

statement ok
ALTER SEMANTIC VIEW v ADD MATERIALIZATION in_own AS METRICS t.total;

statement ok
ALTER SEMANTIC VIEW v ADD MATERIALIZATION in_src IN src AS METRICS u.n;

statement ok
ALTER SEMANTIC VIEW v ADD MATERIALIZATION in_sub IN sub AS METRICS w.weights;

statement ok
ALTER SEMANTIC VIEW v ADD MATERIALIZATION in_views IN views AS METRICS x.xs;

statement ok
ALTER SEMANTIC VIEW v ADD MATERIALIZATION in_other IN other AS METRICS t.total;

# replacing a view also searches the databases storing its current materializations: none is dropped as obsolete
statement ok
CREATE OR REPLACE SEMANTIC VIEW v
  TABLES (t AS t PRIMARY KEY (id), u AS src.u PRIMARY KEY (id), w AS (SELECT * FROM sub.w) PRIMARY KEY (id),
    x AS views.x PRIMARY KEY (id))
  RELATIONSHIPS (u (t_id) REFERENCES t)
  METRICS (t.total AS SUM(amount), u.n AS COUNT(*), w.weights AS SUM(weight), x.xs AS COUNT(*));

query I
SELECT name FROM (SHOW SEMANTIC MATERIALIZATIONS IN v) ORDER BY name;
----
in_other
in_own
in_src
in_sub
in_views

restart

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_src.db' AS src;

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_sub.db' AS sub;

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_other.db' AS other;

statement ok
ATTACH '__TEST_DIR__/restore_catalogs_views.db' AS views;

# a database the view does not use is not searched, even when its materialization metadata cannot be read
statement ok
ATTACH '__TEST_DIR__/restore_catalogs_broken.db' AS broken;

statement ok
CREATE SCHEMA broken.__semantic_materializations;

statement ok
CREATE TABLE broken.__semantic_materializations.__sv_materializations (unexpected INTEGER);

statement ok
CREATE SEMANTIC VIEW v
  TABLES (t AS t PRIMARY KEY (id), u AS src.u PRIMARY KEY (id), w AS (SELECT * FROM sub.w) PRIMARY KEY (id),
    x AS views.x PRIMARY KEY (id))
  RELATIONSHIPS (u (t_id) REFERENCES t)
  METRICS (t.total AS SUM(amount), u.n AS COUNT(*), w.weights AS SUM(weight), x.xs AS COUNT(*));

query I
SELECT name FROM (SHOW SEMANTIC MATERIALIZATIONS IN v) ORDER BY name;
----
in_own
in_src
in_sub
in_views

# the materialization stored in the unused database is kept, and adding it again reattaches it
query I
SELECT count(*) FROM other.__semantic_materializations.__sv_materializations;
----
1

statement ok
ALTER SEMANTIC VIEW v ADD MATERIALIZATION in_other IN other AS METRICS t.total;

query III
SELECT name, storage, last_refresh_detail FROM (SHOW SEMANTIC MATERIALIZATIONS IN v) WHERE name = 'in_other';
----
in_other	other.__semantic_materializations	initial build

query I
SELECT count(*) FROM other.__semantic_materializations.__sv_materializations;
----
1

query IIII
SELECT * FROM SEMANTIC_VIEW(v METRICS t.total, u.n, w.weights, x.xs);
----
15	3	7	1

# name: test/sql/semantic_layer/window_metrics.test
# description: window-function metrics (Snowflake store_sales / date_dim example)
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE date_dim AS SELECT range::INTEGER + 1 AS d_date_sk, DATE '2024-01-01' + range::INTEGER AS d_date, 2024 AS d_year FROM range(10);

statement ok
CREATE TABLE store_sales AS SELECT range::INTEGER + 1 AS ss_sold_date_sk, range::INTEGER + 1 AS ss_quantity FROM range(10) UNION ALL SELECT 3, 5;

statement ok
CREATE SEMANTIC VIEW sv_window_function_example
  TABLES (
    store_sales,
    date AS date_dim PRIMARY KEY (d_date_sk)
  )
  RELATIONSHIPS (
    sales_to_date AS store_sales(ss_sold_date_sk) REFERENCES date(d_date_sk)
  )
  DIMENSIONS (
    date.date AS d_date,
    date.d_date_sk AS d_date_sk,
    date.year AS d_year
  )
  METRICS (
    store_sales.total_sales_quantity AS SUM(ss_quantity)
      WITH SYNONYMS = ('Total sales quantity'),
    store_sales.avg_3_days_sales_quantity AS AVG(total_sales_quantity)
      OVER (PARTITION BY EXCLUDING date.date, date.year ORDER BY date.date
        RANGE BETWEEN INTERVAL '2 days' PRECEDING AND CURRENT ROW),
    store_sales.total_sales_quantity_2_days_ago AS LAG(total_sales_quantity, 2)
      OVER (PARTITION BY EXCLUDING date.date, date.year ORDER BY date.date),
    store_sales.running_total AS SUM(total_sales_quantity)
      OVER (PARTITION BY date.year ORDER BY date.date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
    store_sales.share_of_year AS total_sales_quantity / SUM(total_sales_quantity) OVER (PARTITION BY date.year)
  );

query IIIIII
SELECT date, year, total_sales_quantity, round(avg_3_days_sales_quantity, 3), total_sales_quantity_2_days_ago, running_total
FROM SEMANTIC_VIEW(
  sv_window_function_example
  DIMENSIONS date.date, date.year
  METRICS store_sales.total_sales_quantity, store_sales.avg_3_days_sales_quantity,
          store_sales.total_sales_quantity_2_days_ago, store_sales.running_total
) ORDER BY date;
----
2024-01-01	2024	1	1.0	NULL	1
2024-01-02	2024	2	1.5	NULL	3
2024-01-03	2024	8	3.667	1	11
2024-01-04	2024	4	4.667	2	15
2024-01-05	2024	5	5.667	8	20
2024-01-06	2024	6	5.0	4	26
2024-01-07	2024	7	6.0	5	33
2024-01-08	2024	8	7.0	6	41
2024-01-09	2024	9	8.0	7	50
2024-01-10	2024	10	9.0	8	60

query II
SELECT year, round(sum(share_of_year), 6) FROM SEMANTIC_VIEW(sv_window_function_example DIMENSIONS date.date, date.year METRICS store_sales.share_of_year) GROUP BY 1;
----
2024	1.0

statement error
SELECT * FROM SEMANTIC_VIEW(sv_window_function_example DIMENSIONS date.year METRICS store_sales.avg_3_days_sales_quantity);
----
Dimension 'date.date' used in a window function metric must be requested in the query.

query III
SELECT table_name, name, required FROM (SHOW SEMANTIC DIMENSIONS IN sv_window_function_example FOR METRIC avg_3_days_sales_quantity) ORDER BY name;
----
date	d_date_sk	false
date	date	true
date	year	true

query II
SELECT name, data_type FROM (SHOW SEMANTIC METRICS IN sv_window_function_example) WHERE name = 'running_total';
----
running_total	HUGEINT

statement error
CREATE SEMANTIC VIEW bad TABLES (store_sales, date AS date_dim PRIMARY KEY (d_date_sk)) RELATIONSHIPS (store_sales(ss_sold_date_sk) REFERENCES date) DIMENSIONS (date.date AS d_date) METRICS (store_sales.q AS SUM(ss_quantity), store_sales.w AS SUM(q) OVER (ORDER BY date.date), store_sales.bad AS w * 2);
----
cannot reference window function metric

# LAG / LEAD defaults and offsets are separate AST fields, but can still refer to aggregate metrics.
statement ok
CREATE SEMANTIC VIEW window_arguments
  TABLES (s AS store_sales, d AS date_dim PRIMARY KEY (d_date_sk))
  RELATIONSHIPS (s (ss_sold_date_sk) REFERENCES d)
  DIMENSIONS (d.day AS d_date)
  METRICS (
    s.total AS SUM(ss_quantity),
    s.previous AS LAG(total, 1, total * 2) OVER (ORDER BY d.day),
    s.next AS LEAD(total, CASE WHEN total > 0 THEN 1 ELSE 0 END, total * 2) OVER (ORDER BY d.day)
  );

query III
SELECT * FROM SEMANTIC_VIEW(window_arguments DIMENSIONS d.day METRICS s.previous, s.next) ORDER BY day;
----
2024-01-01	2	2
2024-01-02	1	8
2024-01-03	2	4
2024-01-04	8	5
2024-01-05	4	6
2024-01-06	5	7
2024-01-07	6	8
2024-01-08	7	9
2024-01-09	8	10
2024-01-10	9	20

# Dynamic frame bounds also contain aggregate expressions.
statement ok
CREATE TABLE frame_values (id INTEGER, value INTEGER);
INSERT INTO frame_values VALUES (1, 10), (2, 20), (3, 30);
CREATE SEMANTIC VIEW dynamic_frame
  TABLES (t AS frame_values)
  DIMENSIONS (t.id AS id)
  METRICS (t.total AS SUM(value), t.frame AS SUM(total) OVER (ORDER BY id ROWS BETWEEN MIN(id) PRECEDING AND MAX(id) FOLLOWING));

query II
SELECT * FROM SEMANTIC_VIEW(dynamic_frame DIMENSIONS t.id METRICS t.frame) ORDER BY id;
----
1	30
2	60
3	60

# Argument ORDER BY keys must be resolved and included among required dimensions too.
statement ok
CREATE SEMANTIC VIEW argument_order
  TABLES (t AS frame_values)
  DIMENSIONS (t.id AS id)
  METRICS (t.total AS SUM(value), t.last_value AS FIRST_VALUE(total ORDER BY id DESC) OVER ());

query II
SELECT * FROM SEMANTIC_VIEW(argument_order DIMENSIONS t.id METRICS t.last_value) ORDER BY id;
----
1	30
2	30
3	30

statement error
SELECT * FROM SEMANTIC_VIEW(argument_order METRICS t.last_value);
----
Dimension 't.id' used in a window function metric must be requested in the query.

query II
SELECT name, required FROM (SHOW SEMANTIC DIMENSIONS IN argument_order FOR METRIC last_value);
----
id	true

# name: test/sql/semantic_layer/non_additive.test
# description: semi-additive metrics (NON ADDITIVE BY) aggregate the last snapshot of each group
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE customers (id INTEGER, name VARCHAR);

statement ok
INSERT INTO customers VALUES (1, 'A'), (2, 'B');

statement ok
CREATE TABLE balances (account_id INTEGER, customer_id INTEGER, snapshot_date DATE, balance INTEGER);

statement ok
INSERT INTO balances VALUES
  (1, 1, '2024-01-01', 100), (1, 1, '2024-01-02', 150), (1, 1, '2024-02-01', 120),
  (2, 1, '2024-01-01', 50), (2, 1, '2024-01-02', 60),
  (3, 2, '2024-01-01', 10), (3, 2, '2024-02-01', 30);

statement ok
CREATE SEMANTIC VIEW bank
  TABLES (
    b AS balances PRIMARY KEY (account_id, snapshot_date),
    c AS customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (b (customer_id) REFERENCES c)
  DIMENSIONS (
    b.snapshot_date AS snapshot_date,
    b.month AS DATE_TRUNC('month', snapshot_date),
    b.account AS account_id,
    c.customer AS c.name
  )
  METRICS (
    b.total_balance NON ADDITIVE BY (b.snapshot_date) AS SUM(balance),
    b.opening_balance NON ADDITIVE BY (b.snapshot_date DESC) AS SUM(balance),
    b.sum_all AS SUM(balance),
    b.avg_balance NON ADDITIVE BY (b.snapshot_date) AS AVG(balance)
  );

# latest snapshot overall: 2024-02-01 (accounts 1 and 3)
query I
SELECT * FROM SEMANTIC_VIEW(bank METRICS b.total_balance);
----
150

# DESC: the earliest snapshot
query I
SELECT * FROM SEMANTIC_VIEW(bank METRICS b.opening_balance);
----
160

# the latest snapshot is chosen within every group
query II
SELECT * FROM SEMANTIC_VIEW(bank DIMENSIONS c.customer METRICS b.total_balance) ORDER BY 1;
----
A	120
B	30

query II
SELECT * FROM SEMANTIC_VIEW(bank DIMENSIONS b.month METRICS b.total_balance) ORDER BY 1;
----
2024-01-01 00:00:00	210
2024-02-01 00:00:00	150

query II
SELECT * FROM SEMANTIC_VIEW(bank DIMENSIONS b.account METRICS b.total_balance) ORDER BY 1;
----
1	120
2	60
3	30

# grouping by the non-additive dimension itself is a plain aggregation
query II
SELECT * FROM SEMANTIC_VIEW(bank DIMENSIONS b.snapshot_date METRICS b.total_balance) ORDER BY 1;
----
2024-01-01	160
2024-01-02	210
2024-02-01	150

# an additive metric of the same table in the same query is not filtered
query III
SELECT * FROM SEMANTIC_VIEW(bank DIMENSIONS c.customer METRICS b.total_balance, b.sum_all) ORDER BY 1;
----
A	120	480
B	30	40

query II
SELECT * FROM SEMANTIC_VIEW(bank DIMENSIONS c.customer METRICS b.avg_balance) ORDER BY 1;
----
A	120.0
B	30.0

# filters apply before picking the latest snapshot
query I
SELECT * FROM SEMANTIC_VIEW(bank METRICS b.total_balance WHERE b.snapshot_date < '2024-02-01');
----
210

statement error
CREATE SEMANTIC VIEW bad TABLES (b AS balances PRIMARY KEY (account_id, snapshot_date)) DIMENSIONS (b.d AS snapshot_date) METRICS (b.m NON ADDITIVE BY (b.nope) AS SUM(balance));
----
Unknown column or semantic expression "b.nope"

# NULL snapshots follow the requested NULL ordering (ASC defaults to NULLS LAST: the NULL snapshot is the last one)
statement ok
CREATE TABLE readings (sensor INTEGER, ts INTEGER, val INTEGER);

statement ok
INSERT INTO readings VALUES (1, 1, 10), (1, 2, 20), (1, NULL, 99), (2, 1, 5), (2, 3, 7);

statement ok
CREATE SEMANTIC VIEW meters
  TABLES (r AS readings)
  DIMENSIONS (r.sensor AS sensor, r.ts AS ts)
  METRICS (
    r.last_default NON ADDITIVE BY (r.ts) AS SUM(val),
    r.last_non_null NON ADDITIVE BY (r.ts ASC NULLS FIRST) AS SUM(val),
    r.first_value NON ADDITIVE BY (r.ts DESC) AS SUM(val),
    r.first_or_null NON ADDITIVE BY (r.ts DESC NULLS LAST) AS SUM(val),
    r.multi NON ADDITIVE BY (r.sensor, r.ts) AS SUM(val)
  );

query IIIII
SELECT * FROM SEMANTIC_VIEW(meters DIMENSIONS r.sensor METRICS r.last_default, r.last_non_null, r.first_value, r.first_or_null) ORDER BY 1;
----
1	99	20	10	99
2	7	7	5	5

# several NON ADDITIVE BY dimensions: the last (sensor, ts) pair
query I
SELECT * FROM SEMANTIC_VIEW(meters METRICS r.multi);
----
7

# name: test/sql/semantic_layer/many_to_many.test
# description: many-to-many relationships through bridge tables, without double counting
# group: [semantic_layer]

require semantic_layer

statement ok
PRAGMA enable_verification

# book 1 has two French authors (must count once for FR), book 4 has no author, author 5 (Eve) has no book
statement ok
CREATE TABLE authors (author_id INTEGER, author_name VARCHAR, country VARCHAR, active BOOLEAN, joined DATE, author_revenue INTEGER);
INSERT INTO authors VALUES (1, 'Ann', 'FR', true, '2020-01-01', 100), (2, 'Bob', 'FR', true, '2021-01-01', 50), (3, 'Cid', 'US', false, '2022-01-01', 30), (5, 'Eve', 'DE', true, '2023-01-01', 20);
CREATE TABLE books (book_id INTEGER, title VARCHAR, category VARCHAR, page_count INTEGER);
INSERT INTO books VALUES (1, 'B1', 'novel', 100), (2, 'B2', 'novel', 200), (3, 'B3', 'essay', 300), (4, 'B4', 'essay', 400);
CREATE TABLE book_authors (book_id INTEGER, author_id INTEGER, role VARCHAR);
INSERT INTO book_authors VALUES (1, 1, 'main'), (1, 2, 'co'), (2, 1, 'main'), (2, 3, 'co'), (3, 3, 'main');
CREATE TABLE genres (genre_id INTEGER, genre_name VARCHAR);
INSERT INTO genres VALUES (1, 'drama'), (2, 'history');
CREATE TABLE book_genres (book_id INTEGER, genre_id INTEGER);
INSERT INTO book_genres VALUES (1, 1), (2, 1), (2, 2), (3, 2);

statement ok
CREATE SEMANTIC VIEW library
  TABLES (
    authors PRIMARY KEY (author_id),
    books PRIMARY KEY (book_id),
    book_authors PRIMARY KEY (book_id, author_id),
    genres PRIMARY KEY (genre_id),
    book_genres PRIMARY KEY (book_id, genre_id)
  )
  RELATIONSHIPS (
    book_authors_to_authors AS book_authors (author_id) REFERENCES authors,
    book_authors_to_books AS book_authors (book_id) REFERENCES books,
    book_genres (book_id) REFERENCES books,
    book_genres (genre_id) REFERENCES genres
  )
  DIMENSIONS (
    books.category AS category,
    authors.author_name AS author_name,
    authors.country AS country,
    authors.active AS active,
    genres.genre_name AS genre_name,
    book_authors.role AS role
  )
  METRICS (
    books.total_pages AS SUM(page_count),
    books.book_count AS COUNT(*),
    authors.total_revenue AS SUM(author_revenue),
    pages_per_revenue AS books.total_pages / authors.total_revenue
  );

# every author gets the pages of the books they wrote; the book without author gets a NULL author
query II
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.author_name METRICS books.total_pages) ORDER BY 1 NULLS LAST;
----
Ann	300
Bob	100
Cid	500
NULL	400

# book 1 counts once for FR although both its authors are French
query III
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.country METRICS books.total_pages, books.book_count) ORDER BY 1 NULLS LAST;
----
FR	300	2
US	500	2
NULL	400	1

# without bridged dimensions every book counts once
query II
SELECT * FROM SEMANTIC_VIEW(library METRICS books.total_pages, books.book_count);
----
1000	4

# the other direction: authors by the category of their books; Eve has no book
query II
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS books.category METRICS authors.total_revenue) ORDER BY 1 NULLS LAST;
----
essay	30
novel	180
NULL	20

# a local and a bridged dimension
query III
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS books.category, authors.country METRICS books.total_pages) ORDER BY 1, 2 NULLS LAST;
----
essay	US	300
essay	NULL	400
novel	FR	300
novel	US	200

# two bridges: every book counts once per (country, genre) combination
query III
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.country, genres.genre_name METRICS books.total_pages) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
FR	drama	300
FR	history	200
US	drama	200
US	history	500
NULL	NULL	400

# metrics of two blocks (books through the bridge, authors locally) merged on the dimension, and a derived metric
query IIII
SELECT country, total_pages, total_revenue, round(pages_per_revenue, 2) FROM SEMANTIC_VIEW(library DIMENSIONS authors.country METRICS books.total_pages, authors.total_revenue, pages_per_revenue) ORDER BY 1 NULLS LAST;
----
DE	NULL	20	NULL
FR	300	150	2.0
US	500	30	16.67
NULL	400	NULL	NULL

# an ad-hoc dimension combining the metric's table and the bridged table
query II
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS books.category || '/' || authors.country AS k METRICS books.total_pages) ORDER BY 1 NULLS LAST;
----
essay/US	300
novel/FR	300
novel/US	200
NULL	400

# a dimension stored on the bridge itself is not reachable from books
statement error
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS book_authors.role METRICS books.total_pages);
----
must be related to and have an equal or lower level of granularity

# one dimension cannot need two different bridges
statement error
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.author_name || genres.genre_name AS x METRICS books.total_pages);
----
combines tables reached through different many-to-many bridges

# filters on bridged tables are semi-joins: books with at least one French author, each counted once
query II
SELECT * FROM SEMANTIC_VIEW(library METRICS books.total_pages, books.book_count WHERE authors.country = 'FR');
----
300	2

query II
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS books.category METRICS books.total_pages WHERE authors.country = 'US') ORDER BY 1;
----
essay	300
novel	200

# a bridged and a local condition; only active authors are grouped
query II
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.author_name METRICS books.total_pages WHERE authors.active AND books.category = 'novel') ORDER BY 1;
----
Ann	300
Bob	100

# a condition over the bridged table and the metric's table is evaluated per (book, author) pair
query I
SELECT * FROM SEMANTIC_VIEW(library METRICS books.total_pages WHERE authors.country = 'DE' OR books.category = 'novel');
----
300

# documented: a filter on bridged tables drops books without any author, even IS NULL
query II
SELECT * FROM SEMANTIC_VIEW(library METRICS books.total_pages, books.book_count WHERE authors.author_name IS NULL);
----
NULL	0

# a condition cannot need two different bridges
statement error
SELECT * FROM SEMANTIC_VIEW(library METRICS books.total_pages WHERE authors.country = 'FR' OR genres.genre_name = 'drama');
----
split it into separate conditions combined with AND

# semi-additive metric grouped by a bridged dimension: the last author (by join date) of every category
statement ok
CREATE OR REPLACE SEMANTIC VIEW library_na
  TABLES (authors PRIMARY KEY (author_id), books PRIMARY KEY (book_id), book_authors PRIMARY KEY (book_id, author_id))
  RELATIONSHIPS (book_authors (author_id) REFERENCES authors, book_authors (book_id) REFERENCES books)
  DIMENSIONS (books.category AS category, authors.joined_on AS joined)
  METRICS (authors.latest_revenue NON ADDITIVE BY (authors.joined_on) AS SUM(author_revenue));

query II
SELECT * FROM SEMANTIC_VIEW(library_na DIMENSIONS books.category METRICS authors.latest_revenue) ORDER BY 1 NULLS LAST;
----
essay	30
novel	30
NULL	20

# a fact table is a bridge too: customers who bought in each product category
statement ok
CREATE TABLE customers (customer_id INTEGER, segment VARCHAR);
INSERT INTO customers VALUES (1, 'retail'), (2, 'retail'), (3, 'pro');
CREATE TABLE products (product_id INTEGER, category VARCHAR);
INSERT INTO products VALUES (10, 'toys'), (11, 'books');
CREATE TABLE sales (sale_id INTEGER, customer_id INTEGER, product_id INTEGER, amount INTEGER);
INSERT INTO sales VALUES (1, 1, 10, 5), (2, 1, 10, 7), (3, 1, 11, 3), (4, 2, 10, 4);

statement ok
CREATE SEMANTIC VIEW shop_m2m
  TABLES (customers PRIMARY KEY (customer_id), products PRIMARY KEY (product_id), sales PRIMARY KEY (sale_id))
  RELATIONSHIPS (sales (customer_id) REFERENCES customers, sales (product_id) REFERENCES products)
  DIMENSIONS (products.category AS category, customers.segment AS segment)
  METRICS (customers.customer_count AS COUNT(*), sales.revenue AS SUM(amount));

query II
SELECT * FROM SEMANTIC_VIEW(shop_m2m DIMENSIONS products.category METRICS customers.customer_count) ORDER BY 1 NULLS LAST;
----
books	1
toys	2
NULL	1

query II
SELECT p.category, COUNT(DISTINCT s.customer_id) FROM sales s JOIN products p USING (product_id) GROUP BY 1 ORDER BY 1;
----
books	1
toys	2

# several bridges between the same tables are ambiguous; USING on the metric picks one
statement ok
CREATE TABLE reviews (book_id INTEGER, author_id INTEGER);
INSERT INTO reviews VALUES (3, 1), (4, 2);

statement ok
CREATE SEMANTIC VIEW library_reviews
  TABLES (authors PRIMARY KEY (author_id), books PRIMARY KEY (book_id), book_authors PRIMARY KEY (book_id, author_id), reviews PRIMARY KEY (book_id, author_id))
  RELATIONSHIPS (
    wrote AS book_authors (author_id) REFERENCES authors,
    written AS book_authors (book_id) REFERENCES books,
    reviewed_by AS reviews (author_id) REFERENCES authors,
    reviewed AS reviews (book_id) REFERENCES books
  )
  DIMENSIONS (authors.author_name AS author_name)
  METRICS (
    books.total_pages AS SUM(page_count),
    books.written_pages USING (wrote) AS SUM(page_count),
    books.reviewed_pages USING (reviewed_by) AS SUM(page_count)
  );

statement error
SELECT * FROM SEMANTIC_VIEW(library_reviews DIMENSIONS authors.author_name METRICS books.total_pages);
----
Ambiguous many-to-many path from "books" to "authors": bridge tables "book_authors", "reviews" both qualify

query III
SELECT * FROM SEMANTIC_VIEW(library_reviews DIMENSIONS authors.author_name METRICS books.written_pages, books.reviewed_pages) ORDER BY 1 NULLS LAST;
----
Ann	300	300
Bob	100	400
Cid	500	NULL
NULL	400	300

# dimensions only: the combinations that occur through the bridge
query II
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS books.category, authors.country) ORDER BY 1, 2;
----
essay	US
novel	FR
novel	US

query I
SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.author_name WHERE books.category = 'essay') ORDER BY 1;
----
Cid

# dimensions available for a metric include those reached through a bridge, not the bridge's own
query II
SELECT table_name, name FROM (SHOW SEMANTIC DIMENSIONS IN library FOR METRIC books.total_pages) ORDER BY 1, 2;
----
authors	active
authors	author_name
authors	country
books	category
genres	genre_name

# ambiguous bridges are not listed
query II
SELECT table_name, name FROM (SHOW SEMANTIC DIMENSIONS IN library_reviews FOR METRIC books.total_pages) ORDER BY 1, 2;
----

query II
SELECT table_name, name FROM (SHOW SEMANTIC DIMENSIONS IN library_reviews FOR METRIC books.written_pages) ORDER BY 1, 2;
----
authors	author_name

# the bridge becomes a de-duplicated mapping subquery
query I
SELECT sql ILIKE '%SELECT DISTINCT%book_authors%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(library DIMENSIONS authors.country METRICS books.total_pages)');
----
true

# the metric's table reaches the bridge's anchor through a many-to-one relationship (chapters -> books)
statement ok
CREATE TABLE chapters (chapter_id INTEGER, book_id INTEGER);
INSERT INTO chapters VALUES (1, 1), (2, 1), (3, 2), (4, 4);

statement ok
CREATE SEMANTIC VIEW library_chapters
  TABLES (authors PRIMARY KEY (author_id), books PRIMARY KEY (book_id), book_authors PRIMARY KEY (book_id, author_id), chapters PRIMARY KEY (chapter_id))
  RELATIONSHIPS (book_authors (author_id) REFERENCES authors, book_authors (book_id) REFERENCES books, chapters (book_id) REFERENCES books)
  DIMENSIONS (authors.country AS country, chapters.chapter_no AS chapter_id)
  METRICS (chapters.chapter_count AS COUNT(*));

query II
SELECT * FROM SEMANTIC_VIEW(library_chapters DIMENSIONS authors.country METRICS chapters.chapter_count) ORDER BY 1 NULLS LAST;
----
FR	3
US	1
NULL	1

# the bridge does not reach chapters: one dimension cannot combine both
statement error
SELECT * FROM SEMANTIC_VIEW(library_chapters DIMENSIONS chapters.chapter_no || authors.country AS x METRICS chapters.chapter_count);
----
combines tables that the many-to-many bridge "book_authors" does not relate

# name: test/sql/semantic_views/ddl_errors.test
# description: invalid semantic view definitions are rejected at CREATE time
# group: [semantic_views]

require semantic_views

statement ok
CREATE TABLE orders (id INTEGER, customer_id INTEGER, amount DOUBLE, order_date DATE);

statement ok
CREATE TABLE customers (id INTEGER, name VARCHAR, region_id INTEGER);

statement ok
CREATE TABLE regions (id INTEGER, name VARCHAR, customer_id INTEGER);

statement ok
CREATE TABLE nopk (x INTEGER);

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS missing_table PRIMARY KEY (id)) METRICS (o.n AS COUNT(*));
----
Table with name missing_table does not exist

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders PRIMARY KEY (nope)) METRICS (o.n AS COUNT(*));
----
PRIMARY KEY column "nope" does not exist in logical table "o"

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders, o AS customers) METRICS (o.n AS COUNT(*));
----
Duplicate logical table name "o"

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) DIMENSIONS (x.d AS id);
----
Unknown logical table "x"

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) DIMENSIONS (o.d AS nope_column);
----
Unknown column or semantic expression "nope_column"

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) DIMENSIONS (o.d AS id, o.d AS amount);
----
Duplicate semantic expression "o.d"

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders);
----
A semantic view must define at least one dimension or metric

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders, n AS nopk) RELATIONSHIPS (o (customer_id) REFERENCES n) METRICS (o.c AS COUNT(*));
----
has no PRIMARY KEY or single UNIQUE key

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders PRIMARY KEY (id), c AS customers PRIMARY KEY (id)) RELATIONSHIPS (o (customer_id) REFERENCES c (name)) METRICS (o.c AS COUNT(*));
----
must be the PRIMARY KEY or a UNIQUE key

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders PRIMARY KEY (id), c AS customers PRIMARY KEY (id)) RELATIONSHIPS (o (customer_id, id) REFERENCES c) METRICS (o.c AS COUNT(*));
----
column count mismatch

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders PRIMARY KEY (id)) RELATIONSHIPS (o (customer_id) REFERENCES o) METRICS (o.c AS COUNT(*));
----
cannot reference itself

statement error
CREATE SEMANTIC VIEW sv TABLES (c AS customers PRIMARY KEY (id), r AS regions PRIMARY KEY (id)) RELATIONSHIPS (c (region_id) REFERENCES r, r (customer_id) REFERENCES c) METRICS (c.n AS COUNT(*));
----
circular

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) DIMENSIONS (o.d AS SUM(amount));
----
Dimension "o.d" cannot contain an aggregate

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) METRICS (o.m AS amount * 2);
----
Metric "o.m" must use an aggregate function

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) METRICS (o.m AS SUM(amount), d AS amount + o.m);
----
Derived metric "d" cannot reference

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders) FACTS (o.a AS o.b + 1, o.b AS o.a + 1) DIMENSIONS (o.d AS id);
----
Circular reference

statement error
CREATE SEMANTIC VIEW sv TABLES (o AS orders PRIMARY KEY (id), c AS customers PRIMARY KEY (id)) METRICS (o.m AS SUM(o.amount), c.m AS COUNT(*), total AS m * 2);
----
Ambiguous name "m"

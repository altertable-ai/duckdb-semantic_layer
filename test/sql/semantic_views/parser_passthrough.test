# name: test/sql/semantic_views/parser_passthrough.test
# description: ordinary SQL is unaffected by the semantic_views parser extension
# group: [semantic_views]

require semantic_views

statement ok
CREATE TABLE t AS SELECT range AS i, range % 3 AS g FROM range(10);

query II
WITH c AS (SELECT g, count(*) AS n FROM t GROUP BY g) SELECT g, n FROM c ORDER BY g;
----
0	4
1	3
2	3

query I
SELECT sum(i) OVER () FROM t LIMIT 1;
----
45

statement ok
CREATE VIEW v AS SELECT * FROM t WHERE g = 1;

query I
SELECT count(*) FROM v;
----
3

# a syntax error that has nothing to do with semantic views keeps the postgres message
statement error
SELEC 1;
----
syntax error at or near "SELEC"

# the vendored PEG parser is wired in and round-trips SQL
query I
SELECT rewritten_sql FROM semantic_views_peg_parse('SELECT 1 AS x');
----
SELECT 1 AS x

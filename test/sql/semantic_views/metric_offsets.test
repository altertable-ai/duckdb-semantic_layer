# ad-hoc expressions combining offset and plain metrics; querying by name
query II
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS t.year METRICS invoices.revenue - invoices.revenue_ly AS delta) ORDER BY year;
----
2025	NULL
2026	1750
2027	NULL

query II
SELECT t.year, AGG(invoices.revenue_ly) FROM ledger GROUP BY ALL ORDER BY ALL;
----
2026	2100
2027	3850

# the offset survives the definition round trip
statement ok
ALTER SEMANTIC VIEW ledger RENAME TO ledger_renamed;

query II
SELECT * FROM SEMANTIC_VIEW(ledger_renamed DIMENSIONS t.year METRICS invoices.revenue_ly) ORDER BY year;
----
2026	2100
2027	3850

statement ok
ALTER SEMANTIC VIEW ledger_renamed RENAME TO ledger;

query I
SELECT property_value LIKE 't.day BY %' FROM (DESCRIBE SEMANTIC VIEW ledger) WHERE object_name = 'revenue_ly' AND property = 'OFFSET';
----
true

# offset metrics cannot be materialized; other blocks of the same query still read materializations
statement error
ALTER SEMANTIC VIEW ledger ADD MATERIALIZATION bad AS DIMENSIONS t.month METRICS invoices.revenue_ly;
----
uses OFFSET and cannot be materialized

statement ok
ALTER SEMANTIC VIEW ledger ADD MATERIALIZATION revenue_by_month AS DIMENSIONS t.month METRICS invoices.revenue;

statement ok
ALTER SEMANTIC VIEW ledger SET MAX_STALENESS = 3600;

query I
SELECT sql ILIKE '%ledger__revenue_by_month__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS t.month METRICS invoices.revenue, invoices.revenue_ly)');
----
true

query III
SELECT * FROM SEMANTIC_VIEW(ledger DIMENSIONS t.month METRICS invoices.revenue, invoices.revenue_ly) ORDER BY month;
----

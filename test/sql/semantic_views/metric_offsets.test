2025-10-01	600	NULL
2025-12-01	300	NULL
2026-02-01	250	NULL
2026-09-01	2700	1200
2026-10-01	900	600
2026-12-01	NULL	300
2027-02-01	NULL	250
2027-09-01	NULL	2700
2027-10-01	NULL	900

# TIMESTAMP columns and sub-day intervals
statement ok
CREATE TABLE ticks (id INTEGER, ts TIMESTAMP, v INTEGER);

statement ok
INSERT INTO ticks VALUES (1, '2026-01-01 10:15:00', 1), (2, '2026-01-01 10:45:00', 2), (3, '2026-01-01 11:30:00', 4), (4, '2026-01-01 13:00:00', 8);

statement ok
CREATE SEMANTIC VIEW clock
  TABLES (ticks PRIMARY KEY (id))
  DIMENSIONS (ticks.at AS ts, ticks.hour AS date_trunc('hour', ts))
  METRICS (ticks.total AS SUM(v), ticks.total_prev_hour OFFSET (ticks.at BY INTERVAL 1 HOUR) AS total);

query IIII
SELECT hour, typeof(hour), total, total_prev_hour FROM SEMANTIC_VIEW(clock DIMENSIONS ticks.hour METRICS ticks.total, ticks.total_prev_hour) ORDER BY hour;
----
2026-01-01 10:00:00	TIMESTAMP	3	NULL
2026-01-01 11:00:00	TIMESTAMP	4	3
2026-01-01 12:00:00	TIMESTAMP	NULL	4
2026-01-01 13:00:00	TIMESTAMP	8	NULL
2026-01-01 14:00:00	TIMESTAMP	NULL	8

# errors
statement error
CREATE SEMANTIC VIEW bad TABLES (t AS spine PRIMARY KEY (day), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (invoiced_at) REFERENCES t)
  DIMENSIONS (t.month AS DATE_TRUNC('month', day)::DATE)
  METRICS (invoices.revenue AS SUM(amount), invoices.bad OFFSET (t.month BY INTERVAL 1 YEAR) AS revenue);
----
must be defined as a column of its logical table

statement error
CREATE SEMANTIC VIEW bad TABLES (account AS accounts PRIMARY KEY (account_id), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (account_id) REFERENCES account)
  DIMENSIONS (account.id AS account_id)
  METRICS (invoices.revenue AS SUM(amount), invoices.bad OFFSET (account.id BY INTERVAL 1 YEAR) AS revenue);
----
cannot shift column

statement error
CREATE SEMANTIC VIEW bad TABLES (t AS spine PRIMARY KEY (day), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (invoiced_at) REFERENCES t)
  DIMENSIONS (t.day AS day)
  METRICS (invoices.revenue AS SUM(amount), invoices.bad OFFSET (t.day BY to_days(amount)) AS revenue);
----
the interval must be a constant expression

statement error
CREATE SEMANTIC VIEW bad TABLES (t AS spine PRIMARY KEY (day), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (invoiced_at) REFERENCES t)
  DIMENSIONS (t.day AS day)
  METRICS (invoices.revenue AS SUM(amount), invoices.bad OFFSET (t.day BY to_days(CAST(count(*) AS INTEGER))) AS revenue);
----
the interval must be a constant expression

statement error
CREATE SEMANTIC VIEW bad TABLES (t AS spine PRIMARY KEY (day), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (invoiced_at) REFERENCES t)
  DIMENSIONS (t.day AS day)
  METRICS (invoices.revenue AS SUM(amount), invoices.bad OFFSET (t.nope BY INTERVAL 1 YEAR) AS revenue);
----
nope

statement error
CREATE SEMANTIC VIEW bad TABLES (t AS spine PRIMARY KEY (day), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (invoiced_at) REFERENCES t)
  DIMENSIONS (t.day AS day, invoices.amount_ly OFFSET (t.day BY INTERVAL 1 YEAR) AS amount);
----
OFFSET is only allowed on metrics

statement error
CREATE SEMANTIC VIEW bad TABLES (account AS accounts PRIMARY KEY (account_id), invoices PRIMARY KEY (invoice_id), costs PRIMARY KEY (cost_id))
  RELATIONSHIPS (invoices (account_id) REFERENCES account, costs (account_id) REFERENCES account)
  DIMENSIONS (invoices.invoice_date AS invoiced_at)
  METRICS (costs.cost AS SUM(cost), costs.cost_ly OFFSET (invoices.invoice_date BY INTERVAL 1 YEAR) AS cost);
----
is not reachable from logical table "costs"

statement error
CREATE SEMANTIC VIEW bad TABLES (account AS accounts PRIMARY KEY (account_id), t AS spine PRIMARY KEY (day), invoices PRIMARY KEY (invoice_id))
  RELATIONSHIPS (invoices (account_id) REFERENCES account, invoices (invoiced_at) REFERENCES t)
  FACTS (account.revenue_ly AS invoices.revenue_ly)
  DIMENSIONS (t.day AS day)
  METRICS (invoices.revenue AS SUM(amount), invoices.revenue_ly OFFSET (t.day BY INTERVAL 1 YEAR) AS revenue);
----
which uses OFFSET

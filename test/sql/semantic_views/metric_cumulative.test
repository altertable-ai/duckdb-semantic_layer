2026-01-06	100	100
2026-01-07	100	100
2026-01-08	150	140
2026-01-09	150	90

# a WHERE on another dimension filters the rows; anchors stop at their latest date (2026-02-03 for FR)
query II
SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.month METRICS events.revenue_total WHERE users.country = 'FR') ORDER BY month;

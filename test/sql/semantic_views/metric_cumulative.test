# a WHERE on time selects anchors; their windows still read earlier rows
query III
SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.day METRICS events.revenue_total, events.revenue_7d
  WHERE dates.day BETWEEN DATE '2026-01-05' AND DATE '2026-01-09') ORDER BY day;

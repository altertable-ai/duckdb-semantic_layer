# stored columns of the date table do not move with the anchor
statement error
SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.stored_year METRICS events.revenue_total);
----
would not move with the CUMULATIVE anchor date of metric "revenue_total"

# a TIMESTAMP column of the fact table itself; rows without a date are in no window
statement ok
CREATE TABLE pings (ping_id INTEGER, pinged_at TIMESTAMP, user_id INTEGER);

statement ok
INSERT INTO pings VALUES (1, '2026-01-01 10:00', 1), (2, '2026-01-01 10:30', 2), (3, '2026-01-01 11:15', 1), (4, '2026-01-02 09:00', 3), (5, NULL, 4);

statement ok
CREATE SEMANTIC VIEW pinged TABLES (pings PRIMARY KEY (ping_id)) DIMENSIONS (pings.at_ts AS pinged_at)
  METRICS (
    pings.pings AS COUNT(*),
    pings.pings_total CUMULATIVE (pings.at_ts) AS COUNT(*),
    pings.hau CUMULATIVE (pings.at_ts OVER INTERVAL 1 HOUR) AS COUNT(DISTINCT user_id),
    pings.pings_today CUMULATIVE (pings.at_ts TO DAY) AS COUNT(*)
  );

query III
SELECT at_ts, hau, pings_today FROM SEMANTIC_VIEW(pinged DIMENSIONS pings.at_ts METRICS pings.hau, pings.pings_today) ORDER BY at_ts;
----
2026-01-01 10:00:00	1	1
2026-01-01 10:30:00	2	2
2026-01-01 11:15:00	2	3
2026-01-02 09:00:00	1	1

query III
SELECT pings, pings_total, typeof(hau) FROM SEMANTIC_VIEW(pinged METRICS pings.pings, pings.pings_total, pings.hau);
----
5	4	BIGINT

query I
SELECT typeof(at_ts) FROM SEMANTIC_VIEW(pinged DIMENSIONS pings.at_ts METRICS pings.hau) LIMIT 1;
----
TIMESTAMP

# other blocks of a query still read materializations
statement ok
ALTER SEMANTIC VIEW activity ADD MATERIALIZATION revenue_by_month AS DIMENSIONS dates.month METRICS events.revenue;

statement ok
ALTER SEMANTIC VIEW activity SET MAX_STALENESS = 3600;

query I
SELECT sql ILIKE '%activity__revenue_by_month__0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.month METRICS events.revenue, events.revenue_total)');
----
true

query III
SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.month METRICS events.revenue, events.revenue_total) ORDER BY month;
----
2026-01-01	210	210
2026-02-01	150	360
2026-03-01	90	450

# pre-aggregation: decomposable aggregates are rolled up from states grouped by date ...
query I
SELECT sql LIKE '%__sv_s0_sum%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.month METRICS events.revenue_total)');
----
true

# ... DISTINCT aggregates from rows deduplicated on their arguments ...
query I
SELECT sql LIKE '%GROUP BY __sv_c, __sv_x0%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.month METRICS events.wau)');
----
true

# ... and a block with an opaque aggregate fans out its raw rows
query I
SELECT sql LIKE '%__sv_s0_%' FROM semantic_view_sql('SELECT * FROM SEMANTIC_VIEW(activity DIMENSIONS dates.month METRICS events.median_7d)');
----
false

# pre-aggregated blocks equal the hand-written time-spine query over the raw rows
statement ok
CREATE TABLE big_events AS SELECT range AS event_id, (hash(range) % 50)::INTEGER AS user_id,
  DATE '2026-01-01' + (hash(range * 7) % 200)::INTEGER AS event_date, (hash(range * 13) % 100)::INTEGER AS amount
FROM range(3000);

statement ok
CREATE SEMANTIC VIEW big TABLES (dates PRIMARY KEY (day), e AS big_events PRIMARY KEY (event_id))
  RELATIONSHIPS (e (event_date) REFERENCES dates)
  DIMENSIONS (dates.day AS day, dates.week AS DATE_TRUNC('week', day)::DATE, dates.month AS DATE_TRUNC('month', day)::DATE,
    e.user_bucket AS user_id % 5)
  METRICS (
    e.wau CUMULATIVE (dates.day OVER INTERVAL 7 DAYS) AS COUNT(DISTINCT user_id),
    e.revenue_7d CUMULATIVE (dates.day OVER INTERVAL 7 DAYS) AS SUM(amount),
    e.avg_7d CUMULATIVE (dates.day OVER INTERVAL 7 DAYS) AS AVG(amount),
    e.revenue_mtd CUMULATIVE (dates.day TO MONTH FIRST) AS SUM(amount),
    e.users_total CUMULATIVE (dates.day AVERAGE) AS COUNT(DISTINCT user_id)
  );

query I
WITH s AS (
  SELECT week, user_bucket, wau, revenue_7d, round(avg_7d, 9) AS avg_7d
  FROM SEMANTIC_VIEW(big DIMENSIONS dates.week, e.user_bucket METRICS e.wau, e.revenue_7d, e.avg_7d)
), a AS (
  SELECT d.day AS t, e.user_id % 5 AS b, count(DISTINCT e.user_id) AS wau, sum(e.amount) AS r, avg(e.amount) AS av
  FROM dates d JOIN big_events e ON e.event_date <= d.day AND e.event_date > d.day - INTERVAL 7 DAY
  WHERE d.day <= (SELECT max(event_date) FROM big_events) GROUP BY ALL
), r AS (
  SELECT date_trunc('week', t)::DATE AS week, b AS user_bucket, arg_max(wau, t) AS wau, arg_max(r, t) AS revenue_7d,
    round(arg_max(av, t), 9) AS avg_7d
  FROM a GROUP BY ALL
)
SELECT count(*) FROM ((SELECT * FROM s EXCEPT ALL SELECT * FROM r) UNION ALL (SELECT * FROM r EXCEPT ALL SELECT * FROM s));
----
0

query I
WITH s AS (
  SELECT month, revenue_mtd, round(users_total, 9) AS users_total FROM SEMANTIC_VIEW(big DIMENSIONS dates.month METRICS e.revenue_mtd, e.users_total)
), a1 AS (
  SELECT d.day AS t, sum(e.amount) AS v
  FROM dates d JOIN big_events e ON e.event_date <= d.day AND e.event_date >= date_trunc('month', d.day)
  WHERE d.day <= (SELECT max(event_date) FROM big_events) GROUP BY ALL
), a2 AS (
  SELECT d.day AS t, count(DISTINCT e.user_id) AS v
  FROM dates d JOIN big_events e ON e.event_date <= d.day
  WHERE d.day <= (SELECT max(event_date) FROM big_events) GROUP BY ALL
), r AS (
  SELECT month, revenue_mtd, users_total FROM
    (SELECT date_trunc('month', t)::DATE AS month, arg_min(v, t) AS revenue_mtd FROM a1 GROUP BY 1)
    FULL JOIN (SELECT date_trunc('month', t)::DATE AS month, round(avg(v), 9) AS users_total FROM a2 GROUP BY 1) USING (month)
)
SELECT count(*) FROM ((SELECT * FROM s EXCEPT ALL SELECT * FROM r) UNION ALL (SELECT * FROM r EXCEPT ALL SELECT * FROM s));
----
0

# OFFSET by a month maps several anchors to one date (Jan 29, 30 and 31 + 1 month = Feb 28): LAST still picks one
statement ok
CREATE TABLE clamp_dates AS SELECT range::DATE AS day FROM range(DATE '2026-01-01', DATE '2026-04-01', INTERVAL 1 DAY);

statement ok
CREATE TABLE clamp_events (event_id INTEGER, event_date DATE, amount INTEGER);

statement ok
INSERT INTO clamp_events VALUES (1, '2026-01-29', 1), (2, '2026-01-30', 2), (3, '2026-01-31', 4), (4, '2026-03-31', 8);

statement ok
CREATE SEMANTIC VIEW clamp TABLES (dates AS clamp_dates PRIMARY KEY (day), events AS clamp_events PRIMARY KEY (event_id))
  RELATIONSHIPS (events (event_date) REFERENCES dates) DIMENSIONS (dates.day AS day)
  METRICS (
    events.revenue AS SUM(amount),
    events.rev_1d CUMULATIVE (dates.day OVER INTERVAL 1 DAY) AS SUM(amount),
    events.rev_1d_lm OFFSET (dates.day BY INTERVAL 1 MONTH) AS rev_1d
  );

query II
SELECT * FROM SEMANTIC_VIEW(clamp DIMENSIONS dates.day METRICS events.rev_1d_lm WHERE dates.day = DATE '2026-02-28');
----
2026-02-28	4

query III
SELECT * FROM SEMANTIC_VIEW(clamp DIMENSIONS dates.day METRICS events.rev_1d_lm, events.revenue WHERE dates.day = DATE '2026-02-28');
----
2026-02-28	4	NULL

# tables reached through the date table, and aggregations on it, do not move with the anchor either
statement ok
CREATE TABLE cal_months (month_start DATE, label VARCHAR);

statement ok
INSERT INTO cal_months VALUES ('2026-01-01', 'Jan'), ('2026-02-01', 'Feb'), ('2026-03-01', 'Mar');

statement ok
CREATE TABLE cal_days AS SELECT range::DATE AS day, date_trunc('month', range)::DATE AS month_start FROM range(DATE '2026-01-01', DATE '2026-04-01', INTERVAL 1 DAY);

statement ok
CREATE SEMANTIC VIEW calendar
  TABLES (months AS cal_months PRIMARY KEY (month_start), dates AS cal_days PRIMARY KEY (day), events PRIMARY KEY (event_id))
  RELATIONSHIPS (events (event_date) REFERENCES dates, dates (month_start) REFERENCES months)
  DIMENSIONS (dates.day AS day, dates.month AS date_trunc('month', day), dates.event_count AS COUNT(events.event_id), months.label AS label)
  METRICS (events.revenue_total CUMULATIVE (dates.day) AS SUM(amount));

query II
SELECT * FROM SEMANTIC_VIEW(calendar DIMENSIONS dates.month METRICS events.revenue_total) ORDER BY month;
----
2026-01-01 00:00:00	210
2026-02-01 00:00:00	360
2026-03-01 00:00:00	450

statement error

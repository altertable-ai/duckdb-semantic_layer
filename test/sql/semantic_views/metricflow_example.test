CREATE TABLE metricflow_time_spine AS SELECT range::DATE AS date_day FROM range(DATE '2020-01-01', DATE '2031-01-01', INTERVAL 1 DAY);

statement ok
CREATE SEMANTIC VIEW finance
  TABLES (
    account AS accounts PRIMARY KEY (account_id),
    metric_time AS metricflow_time_spine PRIMARY KEY (date_day),
    invoices PRIMARY KEY (invoice_id),
    infra_costs AS infrastructure_costs PRIMARY KEY (cost_id),
    events AS product_events PRIMARY KEY (event_id),
    trials AS (SELECT event_id, account_id, workspace_id, occurred_at FROM product_events WHERE event_name = 'trial_started')
      PRIMARY KEY (event_id) UNIQUE (account_id, workspace_id, occurred_at),
    subscriptions AS (SELECT event_id, account_id, workspace_id, occurred_at FROM product_events WHERE event_name = 'subscription_started')
      PRIMARY KEY (event_id)
  )
  RELATIONSHIPS (
    invoices (account_id) REFERENCES account,
    invoices (invoiced_at) REFERENCES metric_time,
    infra_costs (account_id) REFERENCES account,
    infra_costs (incurred_at) REFERENCES metric_time,
    events (account_id) REFERENCES account,
    events (occurred_at) REFERENCES metric_time,
    trials (account_id) REFERENCES account,
    trials (occurred_at) REFERENCES metric_time,
    subscriptions (account_id, workspace_id, occurred_at) REFERENCES trials (account_id, workspace_id, ASOF occurred_at)
  )
  DIMENSIONS (
    account.customer_segment AS customer_segment,
    account.country AS country,
    metric_time.day AS date_day,
    metric_time.month AS DATE_TRUNC('month', date_day)::DATE,
    metric_time.year AS DATE_TRUNC('year', date_day)::DATE
  )
  METRICS (
    invoices.revenue AS SUM(amount),
    invoices.refunds AS SUM(refund_amount),
    infra_costs.infra_cost AS SUM(cost),
    invoices.net_revenue AS revenue - refunds,
    gross_profit AS invoices.net_revenue - infra_costs.infra_cost,
    gross_margin AS gross_profit / NULLIF(invoices.net_revenue, 0),
    enterprise_gross_margin FILTER (WHERE account.customer_segment = 'enterprise') AS gross_margin,
    enterprise_gross_margin_ly OFFSET (metric_time.day BY INTERVAL 1 YEAR) AS enterprise_gross_margin,
    enterprise_gross_margin_growth_yoy
      AS (enterprise_gross_margin - enterprise_gross_margin_ly) / NULLIF(enterprise_gross_margin_ly, 0)
      COMMENT = 'Year-over-year percentage change in gross margin for Enterprise customers. '
                'Both periods are restricted to Enterprise accounts.',
    events.trials_started AS COUNT(*) FILTER (WHERE event_name = 'trial_started'),
    events.subscriptions_started AS COUNT(*) FILTER (WHERE event_name = 'subscription_started'),
    PRIVATE trials.trials AS COUNT(*),
    PRIVATE subscriptions.converted_trials
      AS COUNT(DISTINCT trials.event_id) FILTER (WHERE subscriptions.occurred_at <= trials.occurred_at + INTERVAL 14 DAY),
    enterprise_trial_to_paid_14d FILTER (WHERE account.customer_segment = 'enterprise')
      AS subscriptions.converted_trials / NULLIF(trials.trials, 0)
  );

# mf query --metrics enterprise_gross_margin_growth_yoy --group-by metric_time__month --group-by account__country
query IIIII
SELECT month, country, round(enterprise_gross_margin, 6), round(enterprise_gross_margin_ly, 6), round(enterprise_gross_margin_growth_yoy, 6)
FROM SEMANTIC_VIEW(finance DIMENSIONS metric_time.month, account.country
  METRICS enterprise_gross_margin, enterprise_gross_margin_ly, enterprise_gross_margin_growth_yoy
  WHERE metric_time.year = DATE '2026-01-01')
ORDER BY month, country;
----
2026-09-01	DE	0.8	0.685185	0.167568
2026-09-01	FR	0.880952	0.8	0.10119
2026-09-01	US	NULL	NULL	NULL

query IIII
SELECT * FROM SEMANTIC_VIEW(finance DIMENSIONS metric_time.month METRICS events.trials_started, events.subscriptions_started, enterprise_trial_to_paid_14d)
ORDER BY month;
----
2026-09-01	3	2	0.5
2026-10-01	0	1	NULL

query I
SELECT property_value FROM (DESCRIBE SEMANTIC VIEW finance) WHERE object_name = 'enterprise_gross_margin_growth_yoy' AND property = 'COMMENT';
----
Year-over-year percentage change in gross margin for Enterprise customers. Both periods are restricted to Enterprise accounts.

# the dbt document's hand-written SQL (section 14) gives the same result
query I
WITH cur_inv AS (
  SELECT DATE_TRUNC('month', i.invoiced_at)::DATE AS month, a.country, SUM(i.amount) AS revenue, SUM(i.refund_amount) AS refunds
  FROM invoices i JOIN accounts a USING (account_id) WHERE a.customer_segment = 'enterprise' GROUP BY 1, 2
), cur_cost AS (
  SELECT DATE_TRUNC('month', c.incurred_at)::DATE AS month, a.country, SUM(c.cost) AS infra_cost
  FROM infrastructure_costs c JOIN accounts a USING (account_id) WHERE a.customer_segment = 'enterprise' GROUP BY 1, 2
), ly_inv AS (
  SELECT (DATE_TRUNC('month', i.invoiced_at) + INTERVAL 1 YEAR)::DATE AS month, a.country, SUM(i.amount) AS revenue_ly, SUM(i.refund_amount) AS refunds_ly
  FROM invoices i JOIN accounts a USING (account_id) WHERE a.customer_segment = 'enterprise' GROUP BY 1, 2
), ly_cost AS (
  SELECT (DATE_TRUNC('month', c.incurred_at) + INTERVAL 1 YEAR)::DATE AS month, a.country, SUM(c.cost) AS infra_cost_ly
  FROM infrastructure_costs c JOIN accounts a USING (account_id) WHERE a.customer_segment = 'enterprise' GROUP BY 1, 2
), expected AS (
  SELECT month, country,
    (((revenue - refunds - infra_cost) / NULLIF(revenue - refunds, 0)) - ((revenue_ly - refunds_ly - infra_cost_ly) / NULLIF(revenue_ly - refunds_ly, 0)))
    / NULLIF((revenue_ly - refunds_ly - infra_cost_ly) / NULLIF(revenue_ly - refunds_ly, 0), 0) AS growth
  FROM cur_inv LEFT JOIN cur_cost USING (month, country) LEFT JOIN ly_inv USING (month, country) LEFT JOIN ly_cost USING (month, country)
), actual AS (
  SELECT month, country, enterprise_gross_margin_growth_yoy AS growth
  FROM SEMANTIC_VIEW(finance DIMENSIONS metric_time.month, account.country METRICS enterprise_gross_margin_growth_yoy)
  WHERE enterprise_gross_margin_growth_yoy IS NOT NULL
)
SELECT count(*) FROM ((SELECT * FROM expected WHERE growth IS NOT NULL EXCEPT SELECT * FROM actual) UNION ALL (SELECT * FROM actual EXCEPT SELECT * FROM expected));
----
0

# name: test/sql/semantic_views/show_describe.test
# description: SHOW SEMANTIC DIMENSIONS / METRICS / FACTS and DESCRIBE SEMANTIC VIEW
# group: [semantic_views]

require semantic_views

statement ok
CREATE TABLE orders (id INTEGER, customer_id INTEGER, amount DOUBLE, order_date DATE);

statement ok
CREATE TABLE customers (id INTEGER, name VARCHAR);

statement ok
CREATE SEMANTIC VIEW sales
  TABLES (
    o AS orders PRIMARY KEY (id) COMMENT = 'All orders',
    c AS customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (orders_to_customers AS o (customer_id) REFERENCES c)
  FACTS (PRIVATE o.amount_x2 AS amount * 2)
  DIMENSIONS (
    o.order_date AS order_date WITH SYNONYMS = ('day', 'date') COMMENT = 'Date of the order',
    c.customer_name AS c.name
  )
  METRICS (
    o.revenue AS SUM(o.amount),
    PRIVATE o.order_count AS COUNT(*),
    avg_order AS o.revenue / o.order_count
  )
  COMMENT = 'Sales';

query IIIIIII
SELECT database_name, schema_name, semantic_view_name, table_name, name, synonyms, comment FROM (SHOW SEMANTIC DIMENSIONS IN sales) ORDER BY name;
----
memory	main	sales	c	customer_name	NULL	NULL
memory	main	sales	o	order_date	[day, date]	Date of the order

query II
SELECT table_name, name FROM (SHOW SEMANTIC METRICS IN sales) ORDER BY name;
----
NULL	avg_order
o	order_count
o	revenue

query II
SELECT table_name, name FROM (SHOW SEMANTIC FACTS IN sales);
----
o	amount_x2

query II
SELECT table_name, name FROM (SHOW SEMANTIC DIMENSIONS LIKE '%name%' IN SEMANTIC VIEW sales);
----
c	customer_name

# without IN: all semantic views of the current schema
query I
SELECT count(*) FROM (SHOW SEMANTIC METRICS);
----
3

query IIIII
SELECT * FROM (DESCRIBE SEMANTIC VIEW sales) WHERE object_kind IN ('TABLE', 'RELATIONSHIP') ORDER BY object_kind, object_name, property;
----
RELATIONSHIP	orders_to_customers	NULL	FOREIGN_KEY	[customer_id]
RELATIONSHIP	orders_to_customers	NULL	REF_KEY	[id]
RELATIONSHIP	orders_to_customers	NULL	REF_TABLE	c
RELATIONSHIP	orders_to_customers	NULL	TABLE	o
TABLE	c	NULL	BASE_TABLE_DATABASE_NAME	memory
TABLE	c	NULL	BASE_TABLE_NAME	customers
TABLE	c	NULL	BASE_TABLE_SCHEMA_NAME	main
TABLE	c	NULL	PRIMARY_KEY	[id]
TABLE	o	NULL	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	NULL	BASE_TABLE_NAME	orders
TABLE	o	NULL	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	NULL	COMMENT	All orders
TABLE	o	NULL	PRIMARY_KEY	[id]

query IIIII
SELECT * FROM (DESCRIBE SEMANTIC VIEW sales) WHERE object_name IN ('revenue', 'avg_order', 'amount_x2') AND property IN ('TABLE', 'EXPRESSION', 'ACCESS_MODIFIER') ORDER BY object_kind, object_name, property;
----
DERIVED_METRIC	avg_order	NULL	EXPRESSION	(o.revenue / o.order_count)
FACT	amount_x2	o	ACCESS_MODIFIER	PRIVATE
FACT	amount_x2	o	EXPRESSION	(amount * 2)
FACT	amount_x2	o	TABLE	o
METRIC	revenue	o	ACCESS_MODIFIER	PUBLIC
METRIC	revenue	o	EXPRESSION	sum(o.amount)
METRIC	revenue	o	TABLE	o

query IIIII
SELECT * FROM (DESCRIBE SEMANTIC VIEW sales) WHERE object_kind IS NULL ORDER BY property;
----
NULL	NULL	NULL	COMMENT	Sales

statement error
DESCRIBE SEMANTIC VIEW nope;
----
Semantic view with name "nope" does not exist

statement error
SHOW SEMANTIC METRICS IN nope;
----
Semantic view with name "nope" does not exist

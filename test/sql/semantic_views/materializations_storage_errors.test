# name: test/sql/semantic_views/materializations_storage_errors.test
# description: failed builds and operational restoration errors preserve owned storage
# group: [semantic_views]

require semantic_views

statement ok
CREATE TABLE t (id INTEGER, amount HUGEINT);
INSERT INTO t VALUES (1, 170141183460469231731687303715884105727), (2, 1);
CREATE SEMANTIC VIEW v TABLES (t AS t PRIMARY KEY (id)) METRICS (t.n AS COUNT(*), t.total AS SUM(amount));
ALTER SEMANTIC VIEW v ADD MATERIALIZATION counts AS METRICS t.n;

statement error
ALTER SEMANTIC VIEW v ADD MATERIALIZATION overflowing AS METRICS t.total;
----
Overflow

query I
SELECT name FROM (SHOW SEMANTIC MATERIALIZATIONS IN v);
----
counts

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = '__semantic_materializations' AND table_name <> '__sv_materializations';
----
1

statement ok
CREATE MACRO scale(x) AS x * 2;
ALTER SEMANTIC VIEW v ADD MATERIALIZATION custom AS METRICS SUM(scale(t.id));
DROP MACRO scale;

statement error
CREATE OR REPLACE SEMANTIC VIEW v TABLES (t AS t PRIMARY KEY (id)) METRICS (t.n AS COUNT(*), t.total AS SUM(amount));
----
scale does not exist

query I
SELECT count(*) FROM __semantic_materializations.__sv_materializations;
----
2

query I
SELECT * FROM SEMANTIC_VIEW(v METRICS t.n);
----
2

statement ok
CREATE MACRO scale(x) AS x * 2;
UPDATE __semantic_materializations.__sv_materializations SET watermark_catalogs = ['missing'] WHERE name = 'counts';

statement error
CREATE OR REPLACE SEMANTIC VIEW v TABLES (t AS t PRIMARY KEY (id)) METRICS (t.n AS COUNT(*), t.total AS SUM(amount));
----
watermark catalogs and snapshots have different lengths

query I
SELECT count(*) FROM __semantic_materializations.__sv_materializations;
----
2

query I
SELECT * FROM SEMANTIC_VIEW(v METRICS t.n);
----
2

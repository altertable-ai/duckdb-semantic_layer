# name: test/sql/semantic_views/materializations_restore_errors.test
# description: valid read-only storage can be restored and failed DDL preserves the registered view and storage
# group: [semantic_views]

require semantic_views

statement ok
ATTACH '__TEST_DIR__/restore_readonly.db' AS store;
CREATE TABLE t (id INTEGER, amount INTEGER);
INSERT INTO t VALUES (1, 10);
CREATE SEMANTIC VIEW v TABLES (t AS t PRIMARY KEY (id)) METRICS (t.total AS SUM(amount));
ALTER SEMANTIC VIEW v ADD MATERIALIZATION m IN store AS METRICS t.total;
DETACH store;
ATTACH '__TEST_DIR__/restore_readonly.db' AS store (READ_ONLY);

statement ok
CREATE OR REPLACE SEMANTIC VIEW v TABLES (t AS t PRIMARY KEY (id)) METRICS (t.total AS SUM(amount));

query I
SELECT count(*) FROM (SHOW SEMANTIC MATERIALIZATIONS IN v);
----
1

statement error
CREATE OR REPLACE SEMANTIC VIEW v TABLES (t AS t PRIMARY KEY (id)) METRICS (t.n AS COUNT(*));
----
read-only

query I
SELECT * FROM SEMANTIC_VIEW(v METRICS t.total);
----
10

query I
SELECT count(*) FROM store.__semantic_materializations.__sv_materializations;
----
1

statement error
ALTER SEMANTIC VIEW v DROP MATERIALIZATION m;
----
read-only

query I
SELECT count(*) FROM (SHOW SEMANTIC MATERIALIZATIONS IN v);
----
1

statement error
ALTER SEMANTIC VIEW v RENAME TO renamed;
----
read-only

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS) WHERE name = 'v';
----
1

statement error
DROP SEMANTIC VIEW v;
----
read-only

query I
SELECT * FROM SEMANTIC_VIEW(v METRICS t.total);
----
10
